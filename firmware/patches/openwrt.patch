diff --git a/target/linux/airoha/patches-6.18/925-net-airoha-advertise-gro-hw.patch b/target/linux/airoha/patches-6.18/925-net-airoha-advertise-gro-hw.patch
new file mode 100644
index 0000000000000000000000000000000000000000..96f5ebed9d8317b3b4767ad282457af697af73b3
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/925-net-airoha-advertise-gro-hw.patch
@@ -0,0 +1,34 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Codex <codex@openai.com>
+Date: Fri, 4 Sep 2026 17:25:00 +0300
+Subject: [PATCH] net: airoha: advertise the hardware GRO feature bit
+
+The HW-GRO open, fix-features, and set-features paths all test
+NETIF_F_GRO_HW. Device allocation instead advertises NETIF_F_LRO, which
+is a distinct feature bit and is not handled by those paths.
+
+Advertise NETIF_F_GRO_HW so the netdev feature contract matches the
+driver implementation. Keep the feature out of netdev->features so this
+does not change the existing default-disabled policy.
+
+Signed-off-by: Codex <codex@openai.com>
+---
+ drivers/net/ethernet/airoha/airoha_eth.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
+index b37b425..fc1ffdd 100644
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -3866,7 +3866,7 @@ static int airoha_alloc_gdm_device(struct airoha_eth *eth,
+ 	netdev->ethtool_ops = &airoha_ethtool_ops;
+ 	netdev->max_mtu = AIROHA_MAX_MTU;
+ 	netdev->watchdog_timeo = 5 * HZ;
+-	netdev->hw_features = AIROHA_HW_FEATURES | NETIF_F_LRO;
++	netdev->hw_features = AIROHA_HW_FEATURES | NETIF_F_GRO_HW;
+ 	netdev->features |= AIROHA_HW_FEATURES;
+ 	netdev->vlan_features = AIROHA_HW_FEATURES;
+ 	SET_NETDEV_DEV(netdev, eth->dev);
+-- 
+2.51.0
+
