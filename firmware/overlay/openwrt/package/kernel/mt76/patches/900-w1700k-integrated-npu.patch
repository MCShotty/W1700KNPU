Subject: [PATCH] W1700K: merge NPU ownership, recovery and control changes

Rebased onto the pinned non-OC source. This is the experimental
build input; compilation is not a physical drain or recovery proof.

---
--- a/dma.c
+++ b/dma.c
@@ -684,6 +684,14 @@
 
 	if (test_bit(MT76_RESET, &phy->state))
 		goto free_skb;
+	if (mt76_npu_device_active(dev)) {
+		int err = mt76_npu_io_admit(dev);
+
+		if (err) {
+			ret = err;
+			goto free_skb;
+		}
+	}
 
 	/* TODO: Take into account unlinear skbs */
 	if (mt76_npu_device_active(dev) && skb_linearize(skb))
@@ -850,8 +858,12 @@
 	else
 		size = sizeof(struct mt76_desc);
 
-	q->desc = dmam_alloc_coherent(dev->dma_dev, q->ndesc * size,
-				      &q->desc_dma, GFP_KERNEL);
+	ret = mt76_npu_alloc_rx_event(dev, q);
+	if (ret == -EOPNOTSUPP)
+		q->desc = dmam_alloc_coherent(dev->dma_dev, q->ndesc * size,
+					      &q->desc_dma, GFP_KERNEL);
+	else if (ret)
+		return ret;
 	if (!q->desc)
 		return -ENOMEM;
 
