+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include "mt7996.h"
+
+enum mt7996_npu_rro_reset_phase {
+	MT7996_NPU_RRO_UNUSED,
+	MT7996_NPU_RRO_QUEUED,
+	MT7996_NPU_RRO_NPU_POSSIBLE,
+	MT7996_NPU_RRO_NPU_DONE,
+	MT7996_NPU_RRO_MCU_PREPARING,
+	MT7996_NPU_RRO_MCU_POSSIBLE,
+	MT7996_NPU_RRO_MCU_ACKED,
+};
+
+struct mt7996_npu_rro_reset_record {
+	struct list_head list;
+	u64 arrival;
+	u32 generation, ticket;
+	int npu_error, mcu_error, bridge_error;
+	u16 id, wlan_id;
+	u8 tid, phase;
+};
+
+struct mt7996_npu_rro_ba_binding {
+	u64 serial, reset_serial;
+	u16 wlan_id, primary_wlan_id;
+	u8 tid;
+};
+
+/* Arrival ordinals identify host records, not firmware BA lifetimes. No record
+ * or reference is retired until a separately qualified retirement path exists.
+ */
+struct mt7996_npu_rro_reset_owner {
+	struct device *endpoint;
+	struct module *module;
+	struct mt7996_npu_rro_ba_binding *bindings;
+	struct list_head retained, pending, held;
+	spinlock_t lock;
+	u64 arrivals, duplicates, conflicts;
+	int error;
+	bool closing, inflight, joined, retained_once, bad_valid;
+	u16 bad_id, bad_wlan_id;
+	u8 bad_tid;
+	u64 bad_serial;
+	u16 bad_primary_wlan_id;
+	struct mt7996_npu_rro_reset_record records[MT7996_RRO_MAX_SESSION + 1];
+};
+
+static_assert(sizeof(struct mt7996_npu_rro_reset_owner) <= 65536);
+static_assert(sizeof(struct mt7996_npu_rro_ba_binding) *
+	      (MT7996_RRO_MAX_SESSION + 1) <= 32768);
+static LIST_HEAD(mt7996_npu_rro_retained);
+static DEFINE_SPINLOCK(mt7996_npu_rro_retained_lock);
+
+static void mt7996_npu_rro_reset_fail(struct mt7996_dev *dev, int error)
+{
+	int err = mt76_npu_rro_abort(&dev->mt76, error);
+
+	if (!READ_ONCE(dev->recovery.npu_error))
+		WRITE_ONCE(dev->recovery.npu_error, err);
+}
+
+int mt7996_npu_rro_reset_init(struct mt7996_dev *dev)
+{
+	struct mt7996_npu_rro_reset_owner *owner;
+	unsigned int i;
+	int err;
+
+	if (smp_load_acquire(&dev->wed_rro.reset_owner))
+		return -EALREADY;
+	owner = kzalloc(sizeof(*owner), GFP_KERNEL);
+	if (!owner)
+		return -ENOMEM;
+	owner->bindings = kcalloc(ARRAY_SIZE(owner->records),
+				 sizeof(*owner->bindings), GFP_KERNEL);
+	if (!owner->bindings) {
+		kfree(owner);
+		return -ENOMEM;
+	}
+	if (!try_module_get(THIS_MODULE)) {
+		kfree(owner->bindings);
+		kfree(owner);
+		return -ENODEV;
+	}
+	owner->module = THIS_MODULE;
+	owner->endpoint = get_device(dev->mt76.dev);
+	if (!owner->endpoint) {
+		module_put(owner->module);
+		kfree(owner->bindings);
+		kfree(owner);
+		return -ENODEV;
+	}
+	INIT_LIST_HEAD(&owner->retained);
+	INIT_LIST_HEAD(&owner->pending);
+	INIT_LIST_HEAD(&owner->held);
+	spin_lock_init(&owner->lock);
+	for (i = 0; i < ARRAY_SIZE(owner->records); i++) {
+		INIT_LIST_HEAD(&owner->records[i].list);
+		owner->records[i].id = i;
+		/* This owner admits only the first reset request for each ID. The
+		 * journal starts at1; that number does not authenticate a BA lifetime.
+		 */
+		owner->records[i].generation = 1;
+	}
+	spin_lock_bh(&dev->wed_rro.lock);
+	if (dev->wed_rro.reset_closing || dev->wed_rro.reset_owner) {
+		err = dev->wed_rro.reset_closing ? -ESHUTDOWN : -EALREADY;
+	} else {
+		err = READ_ONCE(dev->recovery.npu_error);
+	}
+	if (err) {
+		spin_unlock_bh(&dev->wed_rro.lock);
+		put_device(owner->endpoint);
+		module_put(owner->module);
+		kfree(owner->bindings);
+		kfree(owner);
+		return err < 0 ? err : -EIO;
+	}
+	smp_store_release(&dev->wed_rro.reset_owner, owner);
+	spin_unlock_bh(&dev->wed_rro.lock);
+	return 0;
+}
+
+static struct mt7996_npu_rro_reset_owner *
+mt7996_npu_rro_get_owner(struct mt7996_dev *dev)
+{
+	struct mt7996_npu_rro_reset_owner *owner;
+
+	owner = smp_load_acquire(&dev->wed_rro.reset_owner);
+	if (!owner) {
+		spin_lock_bh(&dev->wed_rro.lock);
+		owner = smp_load_acquire(&dev->wed_rro.reset_owner);
+		if (!owner) {
+			if (!READ_ONCE(dev->recovery.npu_error))
+				WRITE_ONCE(dev->recovery.npu_error, -ENODEV);
+			if (!dev->wed_rro.reset_closing)
+				ieee80211_queue_work(mt76_hw(dev), &dev->wed_rro.work);
+			spin_unlock_bh(&dev->wed_rro.lock);
+			return NULL;
+		}
+		spin_unlock_bh(&dev->wed_rro.lock);
+	}
+	return owner;
+}
+
+static void mt7996_npu_rro_bad_locked(struct mt7996_npu_rro_reset_owner *owner,
+				    u16 id, u16 wlan_id, u8 tid, int err,
+				    u64 serial, u16 primary_wlan_id)
+{
+	if (!owner->error)
+		owner->error = err;
+	if (!owner->bad_valid) {
+		owner->bad_valid = true;
+		owner->bad_id = id;
+		owner->bad_wlan_id = wlan_id;
+		owner->bad_tid = tid;
+		owner->bad_serial = serial;
+		owner->bad_primary_wlan_id = primary_wlan_id;
+	}
+	if (owner->conflicts != U64_MAX)
+		owner->conflicts++;
+}
+
+/* Core association fields are write-once. The serial identifies a host creation,
+ * not a firmware cookie: the first unseen late status still needs a real fence.
+ */
+int mt7996_npu_rro_ba_bind(struct mt7996_dev *dev, u16 id, u16 wlan_id,
+			 u16 primary_wlan_id, u8 tid, u64 serial)
+{
+	struct mt7996_npu_rro_reset_owner *owner;
+	struct mt7996_npu_rro_ba_binding *ba;
+	int err = 0;
+
+	owner = mt7996_npu_rro_get_owner(dev);
+	if (!owner)
+		return -ENODEV;
+	spin_lock_bh(&owner->lock);
+	if (id >= ARRAY_SIZE(owner->records) || !serial || tid >= IEEE80211_NUM_TIDS) {
+		err = -EINVAL;
+		goto bad;
+	}
+	ba = &owner->bindings[id];
+	if (ba->serial) {
+		if (ba->serial != serial || ba->wlan_id != wlan_id ||
+		    ba->primary_wlan_id != primary_wlan_id || ba->tid != tid) {
+			err = -ESTALE;
+			goto bad;
+		}
+	} else {
+		if (owner->records[id].phase != MT7996_NPU_RRO_UNUSED) {
+			err = -ESTALE;
+			goto bad;
+		}
+		ba->wlan_id = wlan_id;
+		ba->primary_wlan_id = primary_wlan_id;
+		ba->tid = tid;
+		ba->serial = serial;
+	}
+	/* Retain late metadata, but do not grant a new ID write or callback. */
+	err = owner->closing ? -ESHUTDOWN : owner->error;
+	spin_unlock_bh(&owner->lock);
+	return err;
+bad:
+	mt7996_npu_rro_bad_locked(owner, id, wlan_id, tid, err, serial, primary_wlan_id);
+	if (!owner->closing)
+		ieee80211_queue_work(mt76_hw(dev), &dev->wed_rro.work);
+	spin_unlock_bh(&owner->lock);
+	return err;
+}
+
+int mt7996_npu_rro_reset_enqueue(struct mt7996_dev *dev, u16 id, u16 wlan_id, u8 tid)
+{
+	struct mt7996_npu_rro_reset_owner *owner;
+	struct mt7996_npu_rro_reset_record *record;
+	struct mt7996_npu_rro_ba_binding *ba;
+	bool queue;
+	int err = 0;
+
+	owner = mt7996_npu_rro_get_owner(dev);
+	if (!owner)
+		return -ENODEV;
+	spin_lock_bh(&owner->lock);
+	if (id >= ARRAY_SIZE(owner->records)) {
+		err = -EINVAL;
+		goto bad;
+	}
+	ba = &owner->bindings[id];
+	if (!ba->serial) {
+		err = -ENODATA;
+		goto bad;
+	}
+	if (ba->wlan_id != wlan_id || ba->tid != tid) {
+		err = -ESTALE;
+		goto bad;
+	}
+	record = &owner->records[id];
+	if (record->phase != MT7996_NPU_RRO_UNUSED) {
+		if (record->wlan_id != wlan_id || record->tid != tid ||
+		    record->phase == MT7996_NPU_RRO_MCU_ACKED) {
+			err = -ESTALE;
+			goto bad;
+		}
+		if (owner->duplicates != U64_MAX)
+			owner->duplicates++;
+		err = -EALREADY;
+		goto unlock;
+	}
+	if (owner->arrivals == U64_MAX) {
+		err = -EOVERFLOW;
+		goto bad;
+	}
+	record->arrival = ++owner->arrivals;
+	record->wlan_id = wlan_id;
+	record->tid = tid;
+	ba->reset_serial = ba->serial;
+	record->phase = MT7996_NPU_RRO_QUEUED;
+	list_add_tail(&record->list, owner->closing || owner->error ?
+		      &owner->held : &owner->pending);
+	goto unlock;
+bad:
+	mt7996_npu_rro_bad_locked(owner, id, wlan_id, tid, err, 0, 0);
+unlock:
+	/* Queue while holding the admission lock so close cannot finish first and
+	 * then have this producer schedule a new consumer callback behind it.
+	 */
+	queue = !owner->closing;
+	if (queue)
+		ieee80211_queue_work(mt76_hw(dev), &dev->wed_rro.work);
+	spin_unlock_bh(&owner->lock);
+	return err;
+}
+
+void mt7996_npu_rro_reset_work(struct mt7996_dev *dev)
+{
+	struct mt7996_npu_rro_reset_owner *owner;
+	struct mt7996_npu_rro_reset_record *record;
+	struct mt7996_npu_rro_ba_binding *ba;
+	bool closing;
+	int err, result, mcu_result;
+
+	owner = smp_load_acquire(&dev->wed_rro.reset_owner);
+	if (!owner) {
+		mt7996_npu_rro_reset_fail(dev, -ENODEV);
+		return;
+	}
+	for (;;) {
+		spin_lock_bh(&owner->lock);
+		if (owner->closing || owner->error) {
+			list_splice_tail_init(&owner->pending, &owner->held);
+			err = owner->error;
+			spin_unlock_bh(&owner->lock);
+			if (err)
+				mt7996_npu_rro_reset_fail(dev, err);
+			return;
+		}
+		if (owner->inflight || list_empty(&owner->pending)) {
+			spin_unlock_bh(&owner->lock);
+			return;
+		}
+		record = list_first_entry(&owner->pending,
+					 struct mt7996_npu_rro_reset_record, list);
+		ba = &owner->bindings[record->id];
+		if (!ba->serial || ba->reset_serial != ba->serial ||
+		    ba->wlan_id != record->wlan_id || ba->tid != record->tid) {
+			mt7996_npu_rro_bad_locked(owner, record->id, record->wlan_id,
+					 record->tid, -ESTALE, ba->reset_serial, ba->primary_wlan_id);
+			list_splice_tail_init(&owner->pending, &owner->held);
+			spin_unlock_bh(&owner->lock);
+			mt7996_npu_rro_reset_fail(dev, -ESTALE);
+			return;
+		}
+		list_del_init(&record->list);
+		owner->inflight = true;
+		record->phase = MT7996_NPU_RRO_NPU_POSSIBLE;
+		spin_unlock_bh(&owner->lock);
+
+		result = is_mt7996(&dev->mt76) ?
+			mt76_npu_rro_reset_npu(&dev->mt76, record->id,
+					       record->generation, &record->ticket) :
+			-EOPNOTSUPP;
+
+		spin_lock_bh(&owner->lock);
+		record->npu_error = result;
+		if (result) {
+			if (!owner->error)
+				owner->error = result < 0 ? result : -EIO;
+			goto retain;
+		}
+		record->phase = MT7996_NPU_RRO_NPU_DONE;
+		if (owner->closing || owner->error)
+			goto retain;
+		record->phase = MT7996_NPU_RRO_MCU_PREPARING;
+		spin_unlock_bh(&owner->lock);
+
+		result = mt76_npu_rro_reset_mcu_begin(&dev->mt76, record->id,
+						     record->generation, record->ticket);
+
+		spin_lock_bh(&owner->lock);
+		record->bridge_error = result;
+		if (result) {
+			if (!owner->error)
+				owner->error = result < 0 ? result : -EIO;
+			goto retain;
+		}
+		if (owner->closing || owner->error)
+			goto retain;
+		/* Close may join this already admitted MCU call, but cannot admit a
+		 * later one. A generic MCU ACK is not BA-generation or DMA-drain proof.
+		 */
+		record->phase = MT7996_NPU_RRO_MCU_POSSIBLE;
+		spin_unlock_bh(&owner->lock);
+
+		mcu_result = mt7996_mcu_wed_rro_reset_sessions(dev, record->id);
+		result = mt76_npu_rro_reset_mcu_complete(&dev->mt76, record->id,
+							record->generation, record->ticket, mcu_result);
+
+		spin_lock_bh(&owner->lock);
+		record->mcu_error = mcu_result;
+		record->bridge_error = result;
+		if (mcu_result || result) {
+			if (!owner->error)
+				owner->error = mcu_result < 0 ? mcu_result : mcu_result ? -EIO :
+					       result < 0 ? result : -EIO;
+		}
+		if (!mcu_result) {
+			record->phase = MT7996_NPU_RRO_MCU_ACKED;
+		}
+retain:
+		owner->inflight = false;
+		list_add_tail(&record->list, &owner->held);
+		if (owner->closing || owner->error)
+			list_splice_tail_init(&owner->pending, &owner->held);
+		err = owner->error;
+		closing = owner->closing;
+		spin_unlock_bh(&owner->lock);
+		if (err)
+			mt7996_npu_rro_reset_fail(dev, err);
+		if (closing || err)
+			return;
+	}
+}
+
+void mt7996_npu_rro_reset_close(struct mt7996_dev *dev)
+{
+	struct mt7996_npu_rro_reset_owner *owner;
+	bool retain;
+
+	spin_lock_bh(&dev->wed_rro.lock);
+	dev->wed_rro.reset_closing = true;
+	owner = smp_load_acquire(&dev->wed_rro.reset_owner);
+	spin_unlock_bh(&dev->wed_rro.lock);
+	if (!owner)
+		return;
+	spin_lock_bh(&owner->lock);
+	owner->closing = true;
+	list_splice_tail_init(&owner->pending, &owner->held);
+	retain = !owner->retained_once;
+	owner->retained_once = true;
+	spin_unlock_bh(&owner->lock);
+	if (retain) {
+		spin_lock_bh(&mt7996_npu_rro_retained_lock);
+		list_add_tail(&owner->retained, &mt7996_npu_rro_retained);
+		spin_unlock_bh(&mt7996_npu_rro_retained_lock);
+	}
+}
+
+void mt7996_npu_rro_reset_join(struct mt7996_dev *dev)
+{
+	struct mt7996_npu_rro_reset_owner *owner;
+
+	owner = smp_load_acquire(&dev->wed_rro.reset_owner);
+	if (!owner)
+		return;
+	spin_lock_bh(&owner->lock);
+	if (!owner->closing) {
+		if (!owner->error)
+			owner->error = -EUCLEAN;
+		spin_unlock_bh(&owner->lock);
+		return;
+	}
+	spin_unlock_bh(&owner->lock);
+
+	/* Keep caller cancellation for legacy WED. Own the retained-work join here:
+	 * inflight can clear before the callback returns. Accepted BA ID writers
+	 * still hold RCU after binding unlocks, so join those read-side sections too.
+	 */
+	cancel_work_sync(&dev->wed_rro.work);
+	synchronize_rcu();
+
+	spin_lock_bh(&owner->lock);
+	if (owner->closing && !owner->inflight)
+		owner->joined = true;
+	else if (!owner->error)
+		owner->error = -EUCLEAN;
+	spin_unlock_bh(&owner->lock);
+}
