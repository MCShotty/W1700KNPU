+	int err;
+
+	mutex_lock(&dev->mutex);
+	npu = rcu_dereference_protected(dev->mmio.npu,
+					lockdep_is_held(&dev->mutex));
+	err = npu ? airoha_npu_wlan_rro_close(npu, dev->dev) : -ENODEV;
+	mutex_unlock(&dev->mutex);
+	return err;
+}
+EXPORT_SYMBOL_GPL(mt76_npu_rro_close);
+
+int mt76_npu_rro_abort(struct mt76_dev *dev, int error)
+{
+	struct airoha_npu *npu;
+	unsigned long flags;
+	int err;
