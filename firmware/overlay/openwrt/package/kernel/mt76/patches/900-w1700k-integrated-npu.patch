Subject: [PATCH] W1700K: merge NPU ownership, recovery and control changes

Rebased onto the pinned non-OC source. This is the experimental
build input; compilation is not a physical drain or recovery proof.

---
--- a/dma.c
+++ b/dma.c
@@ -684,6 +684,14 @@
 
 	if (test_bit(MT76_RESET, &phy->state))
 		goto free_skb;
+	if (mt76_npu_device_active(dev)) {
+		int err = mt76_npu_io_admit(dev);
+
+		if (err) {
+			ret = err;
+			goto free_skb;
+		}
+	}
 
 	/* TODO: Take into account unlinear skbs */
 	if (mt76_npu_device_active(dev) && skb_linearize(skb))
@@ -850,8 +858,12 @@
 	else
 		size = sizeof(struct mt76_desc);
 
-	q->desc = dmam_alloc_coherent(dev->dma_dev, q->ndesc * size,
-				      &q->desc_dma, GFP_KERNEL);
+	ret = mt76_npu_alloc_rx_event(dev, q);
+	if (ret == -EOPNOTSUPP)
+		q->desc = dmam_alloc_coherent(dev->dma_dev, q->ndesc * size,
+					      &q->desc_dma, GFP_KERNEL);
+	else if (ret)
+		return ret;
 	if (!q->desc)
 		return -ENOMEM;
 
@@ -1103,10 +1115,11 @@
 	struct mt76_dev *dev;
 	int qid, done = 0, cur;
 
+	rcu_read_lock();
 	dev = mt76_priv(napi->dev);
 	qid = napi - dev->napi;
-
-	rcu_read_lock();
+	if (!budget)
+		goto out;
 
 	do {
 		cur = mt76_dma_rx_process(dev, &dev->q_rx[qid], budget - done);
@@ -1114,22 +1127,24 @@
 		done += cur;
 	} while (cur && done < budget);
 
-	rcu_read_unlock();
-
 	if (done < budget && napi_complete(napi))
 		dev->drv->rx_poll_complete(dev, qid);
-
+out:
+	rcu_read_unlock();
 	return done;
 }
 EXPORT_SYMBOL_GPL(mt76_dma_rx_poll);
 
-static void
+static int
 mt76_dma_rx_queue_init(struct mt76_dev *dev, enum mt76_rxq_id qid,
 		       int (*poll)(struct napi_struct *napi, int budget))
 {
-	netif_napi_add(dev->napi_dev, &dev->napi[qid], poll);
+	int err = mt76_napi_add(dev, qid, poll);
+
+	if (err)
+		return err;
 	mt76_dma_rx_fill_buf(dev, &dev->q_rx[qid], false);
-	napi_enable(&dev->napi[qid]);
+	return mt76_napi_enable(dev, qid) ? 0 : -ESHUTDOWN;
 }
 
