+static struct napi_struct *
+mt76_napi_get(struct mt76_dev *dev, unsigned int qid)
+{
+	return qid == MT76_NAPI_TX ? &dev->tx_napi : &dev->napi[qid];
+}
+
+int mt76_napi_add(struct mt76_dev *dev, unsigned int qid,
+		  int (*poll)(struct napi_struct *napi, int budget))
+{
+	struct mt76_napi_lifetime *state = &dev->napi_lifetime;
+	struct net_device *netdev;
+	struct napi_struct *napi;
+	bool tracked = dev->drv->drv_flags & MT_DRV_NAPI_LIFETIME;
+	int err = 0;
+
+	if (qid >= MT76_NAPI_MAX || !poll)
+		return -EINVAL;
+	napi = mt76_napi_get(dev, qid);
+	if (tracked)
+		mutex_lock(&state->mutex);
+	if (tracked && state->closing) {
+		err = -ESHUTDOWN;
+		goto out;
+	}
+	if (tracked && test_bit(qid, state->added)) {
+		err = -EEXIST;
+		goto out;
+	}
+	netdev = qid == MT76_NAPI_TX ? dev->tx_napi_dev : dev->napi_dev;
+	if (!netdev) {
+		err = -ENODEV;
+		goto out;
+	}
+	if (qid == MT76_NAPI_TX)
+		netif_napi_add_tx(netdev, napi, poll);
+	else
+		netif_napi_add(netdev, napi, poll);
+	if (tracked)
+		set_bit(qid, state->added);
+out:
+	if (tracked)
+		mutex_unlock(&state->mutex);
+	return err;
+}
+EXPORT_SYMBOL_GPL(mt76_napi_add);
+
+bool mt76_napi_enable(struct mt76_dev *dev, unsigned int qid)
+{
+	struct mt76_napi_lifetime *state = &dev->napi_lifetime;
+	bool enabled = false;
+
+	if (qid >= MT76_NAPI_MAX)
+		return false;
+	if (!(dev->drv->drv_flags & MT_DRV_NAPI_LIFETIME)) {
+		napi_enable(mt76_napi_get(dev, qid));
+		return true;
+	}
+	mutex_lock(&state->mutex);
+	if (state->closing || !test_bit(qid, state->added))
+		goto out;
+	if (!test_bit(qid, state->enabled)) {
+		napi_enable(mt76_napi_get(dev, qid));
+		set_bit(qid, state->enabled);
+	}
+	enabled = true;
+out:
+	mutex_unlock(&state->mutex);
+	return enabled;
+}
+EXPORT_SYMBOL_GPL(mt76_napi_enable);
+
+void mt76_napi_disable(struct mt76_dev *dev, unsigned int qid)
+{
+	struct mt76_napi_lifetime *state = &dev->napi_lifetime;
+
+	if (qid >= MT76_NAPI_MAX)
+		return;
+	if (!(dev->drv->drv_flags & MT_DRV_NAPI_LIFETIME)) {
+		napi_disable(mt76_napi_get(dev, qid));
+		return;
+	}
+	mutex_lock(&state->mutex);
+	if (test_bit(qid, state->enabled)) {
+		napi_disable(mt76_napi_get(dev, qid));
+		clear_bit(qid, state->enabled);
+	}
+	mutex_unlock(&state->mutex);
+}
+EXPORT_SYMBOL_GPL(mt76_napi_disable);
+
+void mt76_napi_cleanup(struct mt76_dev *dev)
+{
+	struct mt76_napi_lifetime *state = &dev->napi_lifetime;
+	unsigned int qid;
+
+	if (!(dev->drv->drv_flags & MT_DRV_NAPI_LIFETIME))
+		return;
+	mutex_lock(&state->mutex);
+	state->closing = true;
+	for_each_set_bit(qid, state->enabled, MT76_NAPI_MAX) {
+		napi_disable(mt76_napi_get(dev, qid));
+		clear_bit(qid, state->enabled);
+	}
+	/* Ownership release precedes the poll's completion/rearm tail. */
+	if (!bitmap_empty(state->added, MT76_NAPI_MAX))
+		synchronize_rcu();
+	for_each_set_bit(qid, state->added, MT76_NAPI_MAX)
+		netif_napi_del(mt76_napi_get(dev, qid));
+	bitmap_zero(state->added, MT76_NAPI_MAX);
+	if (dev->napi_dev) {
+		free_netdev(dev->napi_dev);
+		dev->napi_dev = NULL;
+	}
+	if (dev->tx_napi_dev) {
+		free_netdev(dev->tx_napi_dev);
+		dev->tx_napi_dev = NULL;
+	}
+	mutex_unlock(&state->mutex);
+}
+EXPORT_SYMBOL_GPL(mt76_napi_cleanup);
