+static LIST_HEAD(mt7996_retained_dma);
+static DEFINE_MUTEX(mt7996_retained_dma_lock);
+
+static void mt7996_record_retained_pci(struct mt7996_retained_pci *id,
+				      struct pci_dev *pdev)
+{
+	if (!pdev)
+		return;
+
+	id->pdev = pci_dev_get(pdev);
+	id->domain = pci_domain_nr(pdev->bus);
+	id->bus = pdev->bus->number;
+	id->devfn = pdev->devfn;
+	id->bar_valid = (pci_resource_flags(pdev, 0) & IORESOURCE_MEM) &&
+			pci_resource_len(pdev, 0);
+	id->bar_start = pci_resource_start(pdev, 0);
+	id->bar_end = pci_resource_end(pdev, 0);
+}
+
+static bool mt7996_pci_matches_retained(const struct mt7996_retained_pci *id,
+				       struct pci_dev *pdev)
+{
+	if (!id->pdev)
+		return false;
+	if (id->domain == pci_domain_nr(pdev->bus) &&
+	    id->bus == pdev->bus->number && id->devfn == pdev->devfn)
+		return true;
+
+	return id->bar_valid && (pci_resource_flags(pdev, 0) & IORESOURCE_MEM) &&
+	       pci_resource_len(pdev, 0) &&
+	       pci_resource_start(pdev, 0) <= id->bar_end &&
+	       id->bar_start <= pci_resource_end(pdev, 0);
+}
+
+static bool mt7996_pci_dma_retained(struct pci_dev *pdev)
+{
+	struct mt7996_dev *dev;
+	bool retained = false;
+
+	mutex_lock(&mt7996_retained_dma_lock);
+	list_for_each_entry(dev, &mt7996_retained_dma, retained_dma) {
+		if (mt7996_pci_matches_retained(&dev->retained_pci[0], pdev) ||
+		    mt7996_pci_matches_retained(&dev->retained_pci[1], pdev)) {
+			retained = true;
+			break;
+		}
+	}
+	mutex_unlock(&mt7996_retained_dma_lock);
+
+	return retained;
+}
+
+static void mt7996_pci_keep_dma(struct mt7996_dev *dev, struct pci_dev *pdev,
+				struct pci_dev *hif2)
+{
+	mt7996_record_retained_pci(&dev->retained_pci[0], pdev);
+	mt7996_record_retained_pci(&dev->retained_pci[1], hif2);
+	mutex_lock(&mt7996_retained_dma_lock);
+	list_add_tail(&dev->retained_dma, &mt7996_retained_dma);
+	mutex_unlock(&mt7996_retained_dma_lock);
+}
