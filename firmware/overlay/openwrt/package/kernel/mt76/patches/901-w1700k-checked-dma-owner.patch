diff --git a/mt7996/pci.c b/mt7996/pci.c
index 82b8536..fe9f6a0 100644
--- a/mt7996/pci.c
+++ b/mt7996/pci.c
@@ -15,6 +15,68 @@ static LIST_HEAD(hif_list);
