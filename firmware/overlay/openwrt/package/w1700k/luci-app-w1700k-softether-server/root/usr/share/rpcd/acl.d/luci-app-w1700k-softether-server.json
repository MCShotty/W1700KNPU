{
	"luci-app-w1700k-softether-server": {
		"description": "Manage the local SoftEther VPN server service",
		"read": {
			"cgi-io": [ "exec" ],
			"file": {
				"/etc/init.d/softethervpnserver enabled": [ "exec" ],
				"/etc/init.d/softethervpnserver running": [ "exec" ]
			}
		},
		"write": {
			"cgi-io": [ "exec" ],
			"file": {
				"/etc/init.d/softethervpnserver disable": [ "exec" ],
				"/etc/init.d/softethervpnserver enable": [ "exec" ],
				"/etc/init.d/softethervpnserver restart": [ "exec" ],
				"/etc/init.d/softethervpnserver start": [ "exec" ],
				"/etc/init.d/softethervpnserver stop": [ "exec" ]
			}
		}
	}
}
