From: W1700K firmware work
Subject: [PATCH] net: airoha: npu: preserve pending mailbox ownership

Publish the command before incrementing the mailbox producer counter, as
the stock host transport does. A consumer may observe the new counter
immediately, so the command must already describe the current payload.

Keep a timed-out coherent request buffer owned by that transaction until
DONE is observed. The existing spinlock serializes CPU callers but does
not prevent firmware from accessing a request after the poll timed out.
Return -EBUSY instead of overwriting that request with a new command.

This protects mailbox ownership, not the separate WLAN DMA/RRO graph.

---

--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -172,6 +172,8 @@
 		struct airoha_npu *npu;
 		/* protect concurrent npu memory accesses */
 		spinlock_t lock;
+		/* Firmware may still own the buffer after a timeout. */
+		bool mbox_pending;
 		struct work_struct wdt_work;
 		/* Coherent bounce buffer for mailbox cmd/rsp */
 		void *buf;
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -171,10 +171,10 @@
 				 u16 reply_len)
 {
 	struct airoha_npu_core *core = &npu->cores[0]; /* FIXME: core */
-	u32 val, offset = 0;
+	u32 val, sequence, offset = 0;
 	int ret;
 
-	if (len > AIROHA_NPU_MBOX_SIZE)
+	if (len < 0 || len > AIROHA_NPU_MBOX_SIZE)
 		return -EINVAL;
 
 	if (reply && reply_len > len)
@@ -190,26 +190,57 @@
 	 */
 	spin_lock_bh(&core->lock);
 
+	if (core->mbox_pending) {
+		ret = regmap_read(npu->regmap, REG_CR_MBQ0_CTRL(3) + offset,
+				  &val);
+		if (ret)
+			goto unlock;
+		if (!(val & MBOX_MSG_DONE)) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+		core->mbox_pending = false;
+	}
+
+	ret = regmap_read(npu->regmap, REG_CR_MBQ0_CTRL(2) + offset,
+			  &sequence);
+	if (ret)
+		goto unlock;
+
 	memcpy(core->buf, data, len);
 
-	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(0) + offset, core->addr);
-	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(1) + offset, len);
-	regmap_read(npu->regmap, REG_CR_MBQ0_CTRL(2) + offset, &val);
-	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(2) + offset, val + 1);
+	ret = regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(0) + offset,
+			   core->addr);
+	if (ret)
+		goto unlock;
+	ret = regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(1) + offset, len);
+	if (ret)
+		goto unlock;
+
+	/* From publication onward, an error need not mean no device action. */
+	core->mbox_pending = true;
 	val = FIELD_PREP(MBOX_MSG_FUNC_ID, func_id) | MBOX_MSG_WAIT_RSP;
-	regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(3) + offset, val);
+	ret = regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(3) + offset, val);
+	if (ret)
+		goto unlock;
+	ret = regmap_write(npu->regmap, REG_CR_MBQ0_CTRL(2) + offset,
+			   sequence + 1);
+	if (ret)
+		goto unlock;
 
 	ret = regmap_read_poll_timeout_atomic(npu->regmap,
 					      REG_CR_MBQ0_CTRL(3) + offset,
 					      val, (val & MBOX_MSG_DONE),
 					      100, 100 * MSEC_PER_SEC);
+	if (!ret)
+		core->mbox_pending = false;
 	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
 		ret = -EINVAL;
 
 	/* Copy the trailing reply_len bytes of the response. */
 	if (!ret && reply)
 		memcpy(reply, core->buf + len - reply_len, reply_len);
-
+unlock:
 	spin_unlock_bh(&core->lock);
 
 	return ret;
