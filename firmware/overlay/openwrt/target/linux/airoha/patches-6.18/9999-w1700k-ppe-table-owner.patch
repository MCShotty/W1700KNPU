 DEFINE_MUTEX(flow_offload_mutex);
 static DEFINE_SPINLOCK(ppe_lock);

+struct airoha_ppe_dma_buf {
+	void *va;
+	dma_addr_t addr;
+	size_t size;
+	bool exposed;
+};
+
+struct airoha_ppe_dma_owner {
+	struct device *dev;
+	struct airoha_ppe_dma_buf foe;
+	struct airoha_ppe_dma_buf stats;
+	int setup_error;
+};
+
+/* The board has one front end. Reserve it before any reset on probe. */
+static struct airoha_ppe_dma_owner *w1700k_ppe_owner;
+
+static bool airoha_ppe_dma_exposed(const struct airoha_ppe_dma_owner *owner)
+{
+	return owner->foe.exposed || owner->stats.exposed;
+}
+
+static void airoha_ppe_free_unexposed(struct device *dev,
+				      struct airoha_ppe_dma_buf *buf)
+{
+	if (buf->va && !buf->exposed) {
+		dma_free_coherent(dev, buf->size, buf->va, buf->addr);
+		buf->va = NULL;
+	}
+}
+
+static void airoha_ppe_release_dma(void *data)
+{
+	struct airoha_ppe_dma_owner *owner = data;
+	struct device *dev = owner->dev;
+
+	airoha_ppe_free_unexposed(dev, &owner->stats);
+	airoha_ppe_free_unexposed(dev, &owner->foe);
+
+	/* A mailbox ACK does not fence table access. Keep the board
+	 * reservation, storage and references after a possible publication.
+	 */
+	if (airoha_ppe_dma_exposed(owner)) {
+		dev_warn(dev, "PPE table retirement unverified; retaining DMA memory\n");
+		return;
+	}
+
+	mutex_lock(&flow_offload_mutex);
+	w1700k_ppe_owner = NULL;
+	mutex_unlock(&flow_offload_mutex);
+	put_device(dev);
+	kfree(owner);
+}
+
+int airoha_ppe_prepare_dma(struct airoha_eth *eth)
+{
+	struct airoha_ppe_dma_owner *owner;
+	int err;
+
+	if (!of_machine_is_compatible("gemtek,w1700k-ubi"))
+		return 0;
+
+	owner = kzalloc(sizeof(*owner), GFP_KERNEL);
+	if (!owner)
+		return -ENOMEM;
+
+	mutex_lock(&flow_offload_mutex);
+	if (w1700k_ppe_owner) {
+		mutex_unlock(&flow_offload_mutex);
+		kfree(owner);
+		return -EBUSY;
+	}
+	owner->dev = get_device(eth->dev);
+	w1700k_ppe_owner = owner;
+	mutex_unlock(&flow_offload_mutex);
+
+	err = devm_add_action_or_reset(eth->dev, airoha_ppe_release_dma, owner);
+	if (!err)
+		eth->ppe_dma = owner;
+
+	return err;
+}
+
+static void *airoha_ppe_alloc_table(struct airoha_ppe *ppe, size_t size,
+				    bool stats)
+{
+	struct airoha_ppe_dma_owner *owner = ppe->eth->ppe_dma;
+	dma_addr_t *addr = stats ? &ppe->foe_stats_dma : &ppe->foe_dma;
+	struct airoha_ppe_dma_buf *buf;
+
+	if (!owner)
+		return dmam_alloc_coherent(ppe->eth->dev, size, addr, GFP_KERNEL);
+
+	buf = stats ? &owner->stats : &owner->foe;
+	buf->va = dma_alloc_coherent(owner->dev, size, &buf->addr, GFP_KERNEL);
+	if (!buf->va)
+		return NULL;
+	buf->size = size;
+	*addr = buf->addr;
+
+	return buf->va;
+}
+
+static int airoha_ppe_publish_dma(struct airoha_ppe_dma_owner *owner,
+				  bool stats)
+{
+	struct airoha_ppe_dma_buf *buf;
+
+	lockdep_assert_held(&flow_offload_mutex);
+
+	if (!owner)
+		return 0;
+
+	/* Pin the rebind guard before an address can escape this driver. */
+	if (!airoha_ppe_dma_exposed(owner) && !try_module_get(THIS_MODULE))
+		return -ENODEV;
+	buf = stats ? &owner->stats : &owner->foe;
+	buf->exposed = true;
+
+	return 0;
+}
