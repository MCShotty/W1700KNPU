From: W1700KNPU maintainers
Subject: [PATCH] net: airoha: validate reserved memory before WLAN commands

Snapshot and validate the complete WLAN memory layout before the first
command can wake core 0. Reject short MT7996 TX-check reservations, address
truncation, and overlapping resources. Retain the selected firmware profile
and binary reservation in provider-private storage without changing the
public consumer structure. Check the code and published SRAM backup span
before mapping and copying firmware.

This is startup layout preflight, not hardware quiescence or failure
rollback.

---
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -6,6 +6,7 @@
 
 #include <linux/devcoredump.h>
 #include <linux/firmware.h>
+#include <linux/ioport.h>
 #include <linux/platform_device.h>
 #include <linux/of_net.h>
 #include <linux/of_platform.h>
@@ -22,6 +23,8 @@
 #define NPU_AN7583_FIRMWARE_RV32		"airoha/an7583_npu_rv32.bin"
 #define NPU_EN7581_FIRMWARE_RV32_MAX_SIZE	0x200000
 #define NPU_EN7581_FIRMWARE_DATA_MAX_SIZE	0x10000
+#define NPU_SRAM_BACKUP_SIZE		0x40000
+#define NPU_EN7581_7996_TX_CHECK_SIZE	(0x7000 * sizeof(u16))
 #define NPU_DUMP_SIZE				512
 /*
  * Mailbox DMA payload size. Covers sizeof(struct ppe_mbox_data) (28) and
@@ -123,6 +126,19 @@
 	struct airoha_npu_fw fw_data;
 };
 
+struct airoha_npu_priv {
+	struct airoha_npu npu;
+	struct resource firmware_region;
+	u32 txbuf_min_size;
+};
+
+static bool airoha_npu_memory_valid(const struct resource *res)
+{
+	return res->start && res->end >= res->start &&
+	       !upper_32_bits(res->start) && !upper_32_bits(res->end) &&
+	       IS_ALIGNED(res->start, sizeof(u32));
+}
+
 #define MBOX_MSG_FUNC_ID	GENMASK(14, 11)
 #define MBOX_MSG_STATIC_BUF	BIT(5)
 #define MBOX_MSG_STATUS		GENMASK(4, 2)
@@ -278,9 +294,10 @@
 }
 
 static int
-airoha_npu_load_firmware_from_dts(struct device *dev, void __iomem *addr,
+airoha_npu_load_firmware_from_dts(struct airoha_npu_priv *priv, void __iomem *addr,
 				  void __iomem *base)
 {
+	struct device *dev = priv->npu.dev;
 	const char *fw_names[2];
 	int ret;
 
@@ -290,6 +307,9 @@
 		return dev_err_probe(dev, -EINVAL,
 				     "invalid firmware-name property\n");
 
+	if (!strcmp(fw_names[0], NPU_EN7581_7996_FIRMWARE_RV32))
+		priv->txbuf_min_size = NPU_EN7581_7996_TX_CHECK_SIZE;
+
 	ret = airoha_npu_load_firmware(dev, addr, fw_names[0],
 				       NPU_EN7581_FIRMWARE_RV32_MAX_SIZE);
 	if (ret)
@@ -300,9 +320,10 @@
 					NPU_EN7581_FIRMWARE_DATA_MAX_SIZE);
 }
 
-static int airoha_npu_run_firmware(struct device *dev, void __iomem *base,
+static int airoha_npu_run_firmware(struct airoha_npu_priv *priv, void __iomem *base,
 				   struct resource *res)
 {
+	struct device *dev = priv->npu.dev;
 	const struct airoha_npu_soc_data *soc;
 	void __iomem *addr;
 	int ret;
@@ -311,6 +332,14 @@
 	if (!soc)
 		return -EINVAL;
 
+	/* The probe publishes the backup address immediately after the code area. */
+	if (!airoha_npu_memory_valid(res) ||
+	    resource_size(res) < NPU_EN7581_FIRMWARE_RV32_MAX_SIZE + NPU_SRAM_BACKUP_SIZE)
+		return dev_err_probe(dev, -EINVAL, "invalid NPU firmware memory region\n");
+	priv->firmware_region.start = res->start;
+	priv->firmware_region.end = res->end;
+	priv->txbuf_min_size = 0;
+
 	addr = devm_ioremap_resource(dev, res);
 	if (IS_ERR(addr))
 		return PTR_ERR(addr);
@@ -319,7 +348,10 @@
 	 * dts if available.
 	 */
 	if (of_find_property(dev->of_node, "firmware-name", NULL))
-		return airoha_npu_load_firmware_from_dts(dev, addr, base);
+		return airoha_npu_load_firmware_from_dts(priv, addr, base);
+
+	if (!strcmp(soc->fw_rv32.name, NPU_EN7581_7996_FIRMWARE_RV32))
+		priv->txbuf_min_size = NPU_EN7581_7996_TX_CHECK_SIZE;
 
 	/* Load rv32 npu firmware */
 	ret = airoha_npu_load_firmware(dev, addr, soc->fw_rv32.name,
@@ -562,63 +594,71 @@
 	return err;
 }
 
-static int
-airoha_npu_wlan_set_reserved_memory(struct airoha_npu *npu,
-				    int ifindex, const char *name,
-				    enum airoha_npu_wlan_set_cmd func_id)
-{
-	struct device *dev = npu->dev;
-	struct resource res;
-	int err;
-	u32 val;
-
-	err = of_reserved_mem_region_to_resource_byname(dev->of_node, name,
-							&res);
-	if (err)
-		return err;
-
-	val = res.start;
-	return airoha_npu_wlan_msg_send(npu, ifindex, func_id, &val,
-					sizeof(val), GFP_KERNEL);
-}
-
 static int airoha_npu_wlan_init_memory(struct airoha_npu *npu)
 {
-	enum airoha_npu_wlan_set_cmd cmd = WLAN_FUNC_SET_WAIT_NPU_BAND0_ONCPU;
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+	struct device *dev = npu->dev;
+	struct {
+		const char *name;
+		enum airoha_npu_wlan_set_cmd cmd;
+		struct resource res;
+	} memory[] = {
+		{ .name = "tx-bufid", .cmd = WLAN_FUNC_SET_WAIT_TX_BUF_CHECK_ADDR },
+		{ .name = "pkt", .cmd = WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR },
+		{ .name = "tx-pkt", .cmd = WLAN_FUNC_SET_WAIT_TX_PKT_BUF_ADDR },
+		{ .name = "ba", .cmd = WLAN_FUNC_SET_WAIT_DRAM_BA_NODE_ADDR },
+	};
+	unsigned int i, j, count = ARRAY_SIZE(memory);
 	u32 val = 0;
 	int err;
 
-	err = airoha_npu_wlan_msg_send(npu, 1, cmd, &val, sizeof(val),
-				       GFP_KERNEL);
-	if (err)
-		return err;
-
-	cmd = WLAN_FUNC_SET_WAIT_TX_BUF_CHECK_ADDR;
-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-bufid", cmd);
-	if (err)
-		return err;
+	if (!airoha_npu_memory_valid(&priv->firmware_region))
+		return -EINVAL;
+	if (of_property_match_string(dev->of_node, "memory-region-names", "ba") < 0)
+		count--;
+	/* Snapshot every address before the first command can wake core 0. */
+	for (i = 0; i < count; i++) {
+		struct resource *res = &memory[i].res;
 
-	cmd = WLAN_FUNC_SET_WAIT_PKT_BUF_ADDR;
-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "pkt", cmd);
-	if (err)
-		return err;
+		err = of_reserved_mem_region_to_resource_byname(dev->of_node,
+								memory[i].name, res);
+		if (err)
+			return err;
+		if (!airoha_npu_memory_valid(res))
+			return dev_err_probe(dev, -EINVAL,
+					     "invalid NPU %s memory region\n", memory[i].name);
+		if (priv->txbuf_min_size &&
+		    (res->start < 0x80000000ULL || res->end >= 0xc0000000ULL))
+			return dev_err_probe(dev, -ERANGE,
+					     "NPU %s memory outside firmware DRAM window\n",
+					     memory[i].name);
+		if (resource_overlaps(res, &priv->firmware_region))
+			return dev_err_probe(dev, -EINVAL,
+					     "NPU %s memory overlaps firmware\n", memory[i].name);
+		for (j = 0; j < i; j++)
+			if (resource_overlaps(res, &memory[j].res))
+				return dev_err_probe(dev, -EINVAL,
+						     "overlapping NPU %s memory region\n",
+						     memory[i].name);
+	}
+	if (resource_size(&memory[0].res) < priv->txbuf_min_size)
+		return dev_err_probe(dev, -EINVAL, "NPU tx-bufid memory region too small\n");
 
-	cmd = WLAN_FUNC_SET_WAIT_TX_PKT_BUF_ADDR;
-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-pkt", cmd);
+	err = airoha_npu_wlan_msg_send(npu, 1, WLAN_FUNC_SET_WAIT_NPU_BAND0_ONCPU,
+				       &val, sizeof(val), GFP_KERNEL);
 	if (err)
 		return err;
-
-	if (of_property_match_string(npu->dev->of_node, "memory-region-names",
-				     "ba") >= 0) {
-		cmd = WLAN_FUNC_SET_WAIT_DRAM_BA_NODE_ADDR;
-		err = airoha_npu_wlan_set_reserved_memory(npu, 0, "ba", cmd);
+	for (i = 0; i < count; i++) {
+		val = memory[i].res.start;
+		err = airoha_npu_wlan_msg_send(npu, 0, memory[i].cmd,
+					       &val, sizeof(val), GFP_KERNEL);
 		if (err)
 			return err;
 	}
+	val = 0;
 
-	cmd = WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU;
-	return airoha_npu_wlan_msg_send(npu, 0, cmd, &val, sizeof(val),
-					GFP_KERNEL);
+	return airoha_npu_wlan_msg_send(npu, 0, WLAN_FUNC_SET_WAIT_IS_FORCE_TO_CPU,
+					&val, sizeof(val), GFP_KERNEL);
 }
 
 static u32 airoha_npu_wlan_queue_addr_get(struct airoha_npu *npu, int qid,
@@ -750,6 +790,7 @@
 static int airoha_npu_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
+	struct airoha_npu_priv *priv;
 	struct airoha_npu *npu;
 	struct resource res;
 	void __iomem *base;
@@ -760,9 +801,10 @@
 	if (IS_ERR(base))
 		return PTR_ERR(base);
 
-	npu = devm_kzalloc(dev, sizeof(*npu), GFP_KERNEL);
-	if (!npu)
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
 		return -ENOMEM;
+	npu = &priv->npu;
 
 	npu->dev = dev;
 	npu->ops.ppe_init = airoha_npu_ppe_init;
@@ -836,13 +878,13 @@
 			return -ENOMEM;
 	}
 
-	err = airoha_npu_run_firmware(dev, base, &res);
+	err = airoha_npu_run_firmware(priv, base, &res);
 	if (err)
 		return err;
 
 	regmap_write(npu->regmap, REG_CR_NPU_MIB(10),
 		     res.start + NPU_EN7581_FIRMWARE_RV32_MAX_SIZE);
-	regmap_write(npu->regmap, REG_CR_NPU_MIB(11), 0x40000); /* SRAM 256K */
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(11), NPU_SRAM_BACKUP_SIZE);
 	regmap_write(npu->regmap, REG_CR_NPU_MIB(12), 0);
 	regmap_write(npu->regmap, REG_CR_NPU_MIB(21), 1);
 	msleep(100);
