+static int airoha_npu_start_firmware(struct airoha_npu_priv *priv,
+				     const struct resource *res)
+{
+	struct airoha_npu *npu = &priv->npu;
+	unsigned int i;
+	u32 val;
+	int err;
+
+	if (priv->boot_attempted)
+		return -EBUSY;
+	if (!priv->firmware_loaded || !priv->dma_lifetime ||
+	    !priv->dma_lifetime->exposed)
+		return -EINVAL;
+	if (priv->checked_pair && (!priv->native_published || !priv->boot_identity))
+		return -EINVAL;
+
+	/* Failed writes may have effects. Do not retry or retire exposed storage. */
+	priv->boot_attempted = true;
+	err = regmap_write(npu->regmap, REG_CR_NPU_MIB(10),
+			   res->start + NPU_EN7581_FIRMWARE_RV32_MAX_SIZE);
+	if (err)
+		return err;
+	err = regmap_write(npu->regmap, REG_CR_NPU_MIB(11), NPU_SRAM_BACKUP_SIZE);
+	if (err)
+		return err;
+	err = regmap_write(npu->regmap, REG_CR_NPU_MIB(12), 0);
+	if (err)
+		return err;
+	err = regmap_write(npu->regmap, REG_CR_NPU_MIB(21), 1);
+	if (err)
+		return err;
+	msleep(100);
+
+	for (i = 0; i < NPU_NUM_CORES; i++) {
+		err = regmap_write(npu->regmap, REG_CR_BOOT_BASE(i), res->start);
+		if (err)
+			return err;
+	}
+	usleep_range(1000, 2000);
+
+	err = regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, 0xff);
+	if (err)
+		return err;
+	err = regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 0x1);
+	if (err)
+		return err;
+	msleep(100);
+
+	err = airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
+				      &val, sizeof(val), GFP_KERNEL);
+	if (err)
+		return priv->checked_pair ? err : 0;
+	if (priv->checked_pair && val != NPU_EN7581_NATIVE_VERSION)
+		return -EPROTO;
+	dev_info(npu->dev, "NPU fw version: %0d.%d\n",
+		 (val >> 16) & 0xffff, val & 0xffff);
+
+	return 0;
+}
