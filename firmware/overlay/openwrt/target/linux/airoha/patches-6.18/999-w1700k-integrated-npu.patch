+static int airoha_npu_checked_pair(struct airoha_npu_priv *priv,
+				   const struct firmware *code,
+				   const struct firmware *data)
+{
+	static const u32 tag[] = { NPU_EN7581_PAIR_MAGIC, 1, 32, 0x7996,
+		NPU_EN7581_DATA_DESCRIPTOR, NPU_EN7581_DESCRIPTOR_SIZE, 1, 0 };
+	u32 header[] = { NPU_EN7581_PAIR_MAGIC, 1, NPU_EN7581_DESCRIPTOR_SIZE,
+		0x7996, 1, 0x84000000, code->size,
+		NPU_EN7581_DATA_DESCRIPTOR + NPU_EN7581_DESCRIPTOR_SIZE, 0x3e900000,
+		NPU_EN7581_NATIVE_PLAN, NPU_EN7581_NATIVE_SESSION, 20,
+		NPU_EN7581_NATIVE_IDENTITY, 8, AIROHA_NPU_MBOX_SIZE,
+		NPU_EN7581_DATA_DESCRIPTOR };
+	u8 digest[SHA256_DIGEST_SIZE];
+	const u8 *descriptor;
+	unsigned int i;
+	bool marked_code, marked_data;
+
+	marked_code = code->size >= NPU_EN7581_CODE_TAG + sizeof(tag) &&
+		get_unaligned_le32(code->data + NPU_EN7581_CODE_TAG) == NPU_EN7581_PAIR_MAGIC;
+	marked_data = data->size >= NPU_EN7581_DATA_DESCRIPTOR + sizeof(u32) &&
+		get_unaligned_le32(data->data + NPU_EN7581_DATA_DESCRIPTOR) ==
+		NPU_EN7581_PAIR_MAGIC;
+	if (!marked_code && !marked_data &&
+	    !(priv->txbuf_min_size && (code->size >= 0x40000 || data->size >= 0x6000)))
+		return 0;
+	if (!marked_code || !marked_data || !priv->native_plan_ready ||
+	    data->size != NPU_EN7581_DATA_DESCRIPTOR + NPU_EN7581_DESCRIPTOR_SIZE)
+		return -EINVAL;
+	descriptor = data->data + NPU_EN7581_DATA_DESCRIPTOR;
+	for (i = 0; i < ARRAY_SIZE(tag); i++)
+		if (get_unaligned_le32(code->data + NPU_EN7581_CODE_TAG + 4 * i) != tag[i])
+			return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(header); i++)
+		if (get_unaligned_le32(descriptor + 4 * i) != header[i])
+			return -EINVAL;
+	if (memchr_inv(data->data + NPU_EN7581_NATIVE_PLAN, 0, 48) ||
+	    memchr_inv(data->data + NPU_EN7581_NATIVE_SESSION, 0, 20) ||
+	    memchr_inv(data->data + NPU_EN7581_NATIVE_IDENTITY, 0, 8))
+		return -EINVAL;
+	sha256(code->data, code->size, digest);
+	if (memcmp(digest, descriptor + 64, sizeof(digest)))
+		return -EINVAL;
+	sha256(data->data, NPU_EN7581_DATA_DESCRIPTOR, digest);
+	if (memcmp(digest, descriptor + 96, sizeof(digest)))
+		return -EINVAL;
+
+	return 1;
+}
+
+static int airoha_npu_native_identity(struct airoha_npu_priv *priv)
+{
+	unsigned int i;
+	int ret;
+	u64 identity;
+
+	for (i = 0; i < 3; i++) {
+		ret = get_random_bytes_wait(&identity, sizeof(identity));
+		if (ret)
+			return ret;
+		if (identity) {
+			priv->boot_identity = identity;
+			return 0;
+		}
+	}
+
+	return -EAGAIN;
+}
+
+static int airoha_npu_native_publish(struct airoha_npu_priv *priv, void __iomem *base)
+{
+	unsigned int i;
+	u32 identity[] = { lower_32_bits(priv->boot_identity), upper_32_bits(priv->boot_identity) };
+
+	for (i = 0; i < 12; i++)
+		writel(priv->native_plan[i / 2][i % 2],
+		       base + NPU_EN7581_NATIVE_PLAN + i * sizeof(u32));
+	for (i = 0; i < ARRAY_SIZE(identity); i++)
+		writel(identity[i], base + NPU_EN7581_NATIVE_IDENTITY + i * sizeof(u32));
+	for (i = 0; i < 12; i++)
+		if (readl(base + NPU_EN7581_NATIVE_PLAN + i * sizeof(u32)) !=
+		    priv->native_plan[i / 2][i % 2])
+			return -EIO;
+	for (i = 0; i < ARRAY_SIZE(identity); i++)
+		if (readl(base + NPU_EN7581_NATIVE_IDENTITY + i * sizeof(u32)) != identity[i])
+			return -EIO;
+	for (i = 0; i < 5; i++)
+		if (readl(base + NPU_EN7581_NATIVE_SESSION + i * sizeof(u32)))
+			return -EIO;
+	priv->native_published = true;
+
+	return 0;
+}
+
+static int airoha_npu_load_firmware(struct airoha_npu_priv *priv, void __iomem *addr,
+				    void __iomem *base,
+				    const struct airoha_npu_soc_data *images)
+{
+	struct device *dev = priv->npu.dev;
+	const struct firmware *rv32, *data;
+	int ret;
+
+	/* MT7996 startup consumes these regions before normal WLAN setup. */
+	if (priv->txbuf_min_size) {
+		ret = airoha_npu_wlan_prepare_memory(priv, priv->wlan_memory,
+						     &priv->wlan_memory_count);
+		if (ret)
+			goto invalidate;
+		ret = airoha_npu_wlan_prepare_request(priv);
+		if (ret)
+			goto invalidate;
+	}
+
+	ret = airoha_npu_request_firmware(dev, &images->fw_rv32, &rv32);
+	if (ret)
+		goto invalidate;
+
+	ret = airoha_npu_request_firmware(dev, &images->fw_data, &data);
+	if (ret)
+		goto release_rv32;
+	ret = airoha_npu_checked_pair(priv, rv32, data);
+	if (ret < 0)
+		goto release_data;
+	priv->checked_pair = ret == 1;
+	if (priv->checked_pair) {
+		ret = airoha_npu_native_identity(priv);
+		if (ret)
+			goto release_data;
+	}
+	ret = airoha_npu_firmware_expose(priv);
+	if (ret)
+		goto release_data;
+
+	/* A deferred or invalid second image must not replace just the code. */
+	memcpy_toio(addr, rv32->data, rv32->size);
+	memcpy_toio(base + REG_NPU_LOCAL_SRAM, data->data, data->size);
+	if (priv->checked_pair)
+		ret = airoha_npu_native_publish(priv, base);
+release_data:
+	release_firmware(data);
+release_rv32:
+	release_firmware(rv32);
+invalidate:
+	if (ret) {
+		priv->wlan_memory_count = 0;
+		priv->wlan_request_valid = false;
+		priv->native_plan_ready = false;
+		memset(&priv->wlan_request, 0, sizeof(priv->wlan_request));
+		memset(priv->native_plan, 0, sizeof(priv->native_plan));
+	} else {
+		priv->firmware_loaded = true;
+	}
 
 	return ret;
 }
 
