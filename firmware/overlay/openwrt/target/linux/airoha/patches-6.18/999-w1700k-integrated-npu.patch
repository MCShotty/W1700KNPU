+	life->rx_published = true;
+	*buf = allocated;
+	*addr = allocated_addr;
+	goto unlock;
+hold:
+	priv->wlan_session_error = err;
+	npu_linux_control_close(&priv->wlan_control);
+unlock:
+	mutex_unlock(&priv->wlan_session_lock);
+	return err;
+}
+
+static int airoha_npu_wlan_alloc_tx_buffers_session(struct airoha_npu *npu,
+						    struct device *endpoint,
+						    struct device *dma_dev,
+						    const u32 *bytes, dma_addr_t *addr,
+						    unsigned int count)
+{
+	static const u32 expected[] = {0x20000, 0x20000, 0x40000,
+				       0x40000, 0x40000, 0x40000};
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+	struct airoha_npu_dma_lifetime *life = priv->dma_lifetime;
+	struct npu_linux_control_snapshot snapshot;
+	u32 plan[NPU_EN7581_7996_PLAN_REGIONS][2];
+	struct {
+		void *buf;
+		dma_addr_t addr;
+	} captured[ARRAY_SIZE(expected)];
+	struct {
+		void *buf;
+		dma_addr_t addr;
+	} mailboxes[NPU_NUM_CORES];
+	struct npu_bootstrap_packet command = { .header = NPU_COLD_BIND_HEADER };
+	u32 endpoint_base, endpoint_bytes, bound_serial, value;
+	void *rx_buf;
+	dma_addr_t rx_addr;
+	u32 rx_bytes, rx_serial;
+	bool rx_published;
+	unsigned int i;
+	int err = 0;
+
+	if (!priv->checked_pair)
+		return -EOPNOTSUPP;
+	if (!endpoint || dma_dev != npu->dev || !bytes || !addr ||
+	    count != ARRAY_SIZE(expected))
+		return -EINVAL;
+	for (i = 0; i < count; i++)
+		if (bytes[i] != expected[i])
+			return -EINVAL;
+	mutex_lock(&priv->wlan_session_lock);
+	if (priv->wlan_session_error) {
+		err = priv->wlan_session_error;
+		goto unlock;
+	}
+	if (!life || life->dev != dma_dev || !life->exposed ||
+	    !life->endpoint_bound || life->endpoint != endpoint ||
+	    !priv->native_published || life->tx_attempted || life->tx_published) {
+		err = -EBUSY;
+		goto unlock;
+	}
+	for (i = 0; i < count; i++)
+		if (life->tx_buffers[i].buf || life->tx_buffers[i].addr ||
+		    life->tx_buffers[i].bytes) {
+			err = -EBUSY;
+			goto unlock;
+		}
+	err = airoha_npu_wlan_session_snapshot(priv, true);
+	if (err)
+		goto hold;
+	npu_linux_control_snapshot(&priv->wlan_control, &snapshot);
+	if (life->boot_identity != priv->boot_identity ||
+	    life->nonce_lo != snapshot.client.base.nonce_lo ||
+	    life->nonce_hi != snapshot.client.base.nonce_hi ||
+	    (life->rx_published ? life->rx_serial : life->bound_serial) !=
+	    snapshot.client.base.serial ||
+	    life->rx_attempted != life->rx_published ||
+	    (life->rx_published ? !airoha_npu_wlan_rx_event_valid(priv) :
+	     life->rx_event.buf || life->rx_event.addr ||
+	     life->rx_event.bytes || life->rx_serial) ||
+	    snapshot.descriptor_gets || snapshot.descriptor_arena || snapshot.txbuf_steps ||
+	    snapshot.txbuf_enrolled != (life->rx_published ? NPU_COLD_TXBUF_MAILBOXES : 0) ||
+	    snapshot.rx_event != (life->rx_published ? life->rx_event.addr : 0) ||
+	    snapshot.rx_event_steps) {
+		err = -EPROTO;
+		goto hold;
+	}
+	/* Firmware is already exposed. Retain even partial TX allocations. */
+	memcpy(plan, priv->native_plan, sizeof(plan));
+	endpoint_base = life->endpoint_base;
+	endpoint_bytes = life->endpoint_bytes;
+	bound_serial = life->bound_serial;
+	rx_buf = life->rx_event.buf;
+	rx_addr = life->rx_event.addr;
+	rx_bytes = life->rx_event.bytes;
+	rx_serial = life->rx_serial;
+	rx_published = life->rx_published;
+	for (i = 0; i < ARRAY_SIZE(mailboxes); i++) {
+		if (!life->buffers[i].buf || !life->buffers[i].addr ||
+		    upper_32_bits(life->buffers[i].addr)) {
+			err = -EPROTO;
+			goto hold;
+		}
+		mailboxes[i].buf = life->buffers[i].buf;
+		mailboxes[i].addr = life->buffers[i].addr;
+	}
+	life->tx_attempted = true;
+	for (i = 0; i < count; i++) {
+		life->tx_buffers[i].bytes = expected[i];
+		life->tx_buffers[i].buf = dma_alloc_coherent(dma_dev, expected[i],
+							     &life->tx_buffers[i].addr,
+							     GFP_KERNEL);
+		if (!life->tx_buffers[i].buf) {
+			err = -ENOMEM;
+			goto hold;
+		}
+		if (!airoha_npu_wlan_tx_buffer_valid(priv, i)) {
+			err = -EINVAL;
+			goto hold;
+		}
+		captured[i].buf = life->tx_buffers[i].buf;
+		captured[i].addr = life->tx_buffers[i].addr;
+	}
+	err = npu_linux_control_exchange(&priv->wlan_control, NPU_CONTROL_STATUS);
+	if (err)
+		goto hold;
+	err = airoha_npu_wlan_session_snapshot(priv, true);
+	if (err)
+		goto hold;
+	npu_linux_control_snapshot(&priv->wlan_control, &snapshot);
+	if (priv->dma_lifetime != life || life->dev != dma_dev ||
+	    npu->dev != dma_dev || !life->exposed || !life->endpoint_bound ||
+	    life->endpoint != endpoint || !life->tx_attempted || life->tx_published ||
+	    life->boot_identity != priv->boot_identity ||
+	    life->nonce_lo != snapshot.client.base.nonce_lo ||
+	    life->nonce_hi != snapshot.client.base.nonce_hi ||
+	    life->rx_event.buf != rx_buf || life->rx_event.addr != rx_addr ||
+	    life->rx_event.bytes != rx_bytes || life->rx_serial != rx_serial ||
+	    life->rx_published != rx_published ||
+	    life->rx_attempted != rx_published ||
+	    snapshot.descriptor_gets || snapshot.descriptor_arena || snapshot.txbuf_steps ||
+	    snapshot.txbuf_enrolled != (rx_published ? NPU_COLD_TXBUF_MAILBOXES : 0) ||
+	    snapshot.rx_event != (rx_published ? rx_addr : 0) || snapshot.rx_event_steps ||
+	    memcmp(plan, priv->native_plan, sizeof(plan))) {
+		err = -EPROTO;
+		goto hold;
+	}
+	for (i = 0; i < count; i++)
+		if (life->tx_buffers[i].buf != captured[i].buf ||
+		    life->tx_buffers[i].addr != captured[i].addr ||
+		    life->tx_buffers[i].bytes != expected[i] ||
+		    !airoha_npu_wlan_tx_buffer_valid(priv, i)) {
+			err = -EPROTO;
+			goto hold;
+		}
+	/* Enroll all mailbox and TX extents before the caller can publish a handle.
+	 * A lost reply retains both the native reservation and every CPU allocation.
+	 */
+	for (i = rx_published ? NPU_COLD_TXBUF_MAILBOXES : 0; i < NPU_COLD_TXBUF_RECORDS; i++) {
+		command.api = NPU_COLD_BIND_DMA_API + i;
+		command.value = i < ARRAY_SIZE(mailboxes) ? mailboxes[i].addr :
+				captured[i - ARRAY_SIZE(mailboxes)].addr;
+		err = npu_linux_control_cold_exchange(&priv->wlan_control, &command, &value);
+		if (err)
+			goto hold;
+	}
+	err = npu_linux_control_exchange(&priv->wlan_control, NPU_CONTROL_STATUS);
+	if (err)
+		goto hold;
+	err = airoha_npu_wlan_session_snapshot(priv, true);
+	if (err)
+		goto hold;
+	npu_linux_control_snapshot(&priv->wlan_control, &snapshot);
+	if (priv->dma_lifetime != life || life->dev != dma_dev || npu->dev != dma_dev ||
+	    !life->exposed || !life->endpoint_bound || life->endpoint != endpoint ||
+	    !life->tx_attempted || life->tx_published ||
+	    life->boot_identity != priv->boot_identity ||
+	    life->nonce_lo != snapshot.client.base.nonce_lo ||
+	    life->nonce_hi != snapshot.client.base.nonce_hi ||
+	    life->rx_event.buf != rx_buf || life->rx_event.addr != rx_addr ||
+	    life->rx_event.bytes != rx_bytes || life->rx_serial != rx_serial ||
+	    life->rx_published != rx_published ||
+	    life->rx_attempted != rx_published ||
+	    life->endpoint_base != endpoint_base || life->endpoint_bytes != endpoint_bytes ||
+	    life->bound_serial != bound_serial || snapshot.descriptor_gets ||
+	    snapshot.descriptor_arena || snapshot.txbuf_enrolled != NPU_COLD_TXBUF_RECORDS ||
+	    snapshot.rx_event != (rx_published ? rx_addr : 0) || snapshot.rx_event_steps ||
+	    memcmp(plan, priv->native_plan, sizeof(plan))) {
+		err = -EPROTO;
+		goto hold;
+	}
+	for (i = 0; i < ARRAY_SIZE(mailboxes); i++)
+		if (life->buffers[i].buf != mailboxes[i].buf ||
+		    life->buffers[i].addr != mailboxes[i].addr) {
+			err = -EPROTO;
+			goto hold;
+		}
+	for (i = 0; i < count; i++)
+		if (life->tx_buffers[i].buf != captured[i].buf ||
+		    life->tx_buffers[i].addr != captured[i].addr ||
+		    life->tx_buffers[i].bytes != expected[i] ||
+		    !airoha_npu_wlan_tx_buffer_valid(priv, i)) {
+			err = -EPROTO;
+			goto hold;
+		}
+	/* Latch before returning addresses which a caller may publish immediately. */
+	life->tx_published = true;
+	for (i = 0; i < count; i++)
+		addr[i] = life->tx_buffers[i].addr;
+	goto unlock;
+hold:
+	priv->wlan_session_error = err;
+	npu_linux_control_close(&priv->wlan_control);
+unlock:
+	mutex_unlock(&priv->wlan_session_lock);
+	return err;
+}
+
+static bool airoha_npu_wlan_tail_lifetime_valid(struct airoha_npu_priv *priv)
+{
+	static const u32 bytes[] = {0x20000, 0x20000, 0x40000, 0x40000, 0x40000, 0x40000};
+	struct airoha_npu_dma_lifetime *life = priv->dma_lifetime;
+	struct npu_linux_control *control = &priv->wlan_control;
+	unsigned int i;
+
+	if (!life || !life->exposed || !priv->native_published || life->dev != priv->npu.dev ||
+	    !life->endpoint_bound || !life->endpoint || life->boot_identity != priv->boot_identity ||
+	    !life->rx_attempted || !life->rx_published || !life->rx_serial ||
+	    !life->tx_attempted || !life->tx_published || !life->rx_event.buf ||
+	    life->rx_event.bytes != NPU_COLD_RX_EVENT_BYTES ||
+	    life->rx_event.addr != control->rx_event || !airoha_npu_wlan_rx_event_valid(priv) ||
+	    !npu_cold_endpoint_valid(life->endpoint_base, life->endpoint_bytes) ||
+	    life->nonce_lo != control->client.base.nonce_lo || life->nonce_hi != control->client.base.nonce_hi ||
+	    control->tx0_register != life->endpoint_base + NPU_COLD_TX_REG0 ||
+	    (control->tx2_register != life->endpoint_base + NPU_COLD_TX_REG2 &&
+	     control->tx2_register != life->endpoint_base + NPU_COLD_TX_REG2 + NPU_COLD_TX_HIF2) ||
+	    control->tx2_register - life->endpoint_base > life->endpoint_bytes - 0x110u - 12u)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(bytes); i++)
+		if (!life->tx_buffers[i].buf || life->tx_buffers[i].bytes != bytes[i] ||
+		    !airoha_npu_wlan_tx_buffer_valid(priv, i))
+			return false;
+	return true;
+}
+
+static int airoha_npu_wlan_cold_command(struct airoha_npu *npu, u32 header,
+					u32 api, void *data, int len)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+	struct airoha_npu_dma_lifetime *life, captured;
+	const size_t lease_offset = offsetof(struct airoha_npu_dma_lifetime, buffers);
+	struct npu_bootstrap_packet command = { .header = header, .api = api };
+	u32 plan[NPU_EN7581_7996_PLAN_REGIONS][2];
+	u32 value, tail, inode;
+	bool pinned;
+	int err;
+
+	if (!data || len != sizeof(value))
+		return -EINVAL;
+	if ((header & ~0xfU) != 0x30)
+		command.value = get_unaligned_le32(data);
+	tail = npu_cold_pcie_tail_command_step(&command);
+	inode = npu_cold_inode_command_step(&command);
+	pinned = tail < NPU_COLD_PCIE_TAIL_STAGES || inode < NPU_COLD_INODE_STAGES;
+	mutex_lock(&priv->wlan_session_lock);
+	life = priv->dma_lifetime;
+	if (priv->wlan_session_error) {
+		err = priv->wlan_session_error;
+		goto unlock;
+	}
+	if (!priv->wlan_session_attempted || !priv->wlan_control.initialized) {
+		err = -EINVAL;
+		goto unlock;
+	}
+	if ((npu_cold_rx_event_command(&command) || npu_cold_txdone_command(&command) ||
+	     npu_cold_rx_pcie_command(&command)) &&
+	    (!life || !life->exposed || !priv->native_published ||
+	     life->dev != npu->dev || !life->endpoint_bound || !life->endpoint ||
+	     life->boot_identity != priv->boot_identity ||
+	     !life->rx_attempted || !life->rx_published || !life->rx_serial ||
+	     !life->tx_attempted || !life->tx_published || !life->rx_event.buf ||
+	     life->rx_event.bytes != NPU_COLD_RX_EVENT_BYTES ||
+	     (npu_cold_rx_event_command(&command) && life->rx_event.addr != command.value) ||
+	     (npu_cold_txdone_command(&command) && command.value != NPU_COLD_RX_EVENT_COUNT)))
+		err = -EPROTO;
+	else if (npu_cold_rx_pcie_command(&command) &&
+		 (!npu_cold_endpoint_valid(life->endpoint_base, life->endpoint_bytes) ||
+		  life->endpoint_bytes < NPU_COLD_RX_PCIE_REGISTER_BYTES ||
+		  NPU_COLD_RX_PCIE_REGISTER > life->endpoint_bytes - NPU_COLD_RX_PCIE_REGISTER_BYTES ||
+		  command.value != life->endpoint_base + NPU_COLD_RX_PCIE_REGISTER ||
+		  life->nonce_lo != priv->wlan_control.client.base.nonce_lo ||
+		  life->nonce_hi != priv->wlan_control.client.base.nonce_hi))
+		err = -EPROTO;
+	else if (pinned && (!priv->checked_pair || !airoha_npu_wlan_tail_lifetime_valid(priv)))
+		err = -EPROTO;
+	else {
+		if (pinned) {
+			/* Cleanup owns the retained-list links independently of this lane. */
+			captured.dev = life->dev;
+			memcpy((u8 *)&captured + lease_offset, (u8 *)life + lease_offset,
+			       sizeof(captured) - lease_offset);
+			memcpy(plan, priv->native_plan, sizeof(plan));
+		}
+		err = npu_linux_control_cold_exchange(&priv->wlan_control, &command, &value);
+	}
+	if (!err && pinned &&
+	    (priv->dma_lifetime != life || !priv->checked_pair || life->dev != captured.dev ||
+	     memcmp((u8 *)life + lease_offset, (u8 *)&captured + lease_offset,
+		    sizeof(captured) - lease_offset) ||
+	     memcmp(plan, priv->native_plan, sizeof(plan)) ||
+	     !airoha_npu_wlan_tail_lifetime_valid(priv)))
+		err = -EPROTO;
+	if (err) {
+		priv->wlan_session_error = err;
+		npu_linux_control_close(&priv->wlan_control);
+	} else if ((header & ~0xfU) == 0x30) {
+		put_unaligned_le32(value, data);
+	}
+unlock:
+	mutex_unlock(&priv->wlan_session_lock);
+	return err;
+}
+
+static int airoha_npu_wlan_msg_send_session(struct airoha_npu *npu, int ifindex,
+					    enum airoha_npu_wlan_set_cmd func_id,
+					    void *data, int data_len, gfp_t gfp)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+
+	if (priv->checked_pair && func_id == WLAN_FUNC_SET_WAIT_INODE_TXRX_REG_ADDR) {
+		if (ifindex != 2 && ifindex != 7)
+			return -EINVAL;
+		return airoha_npu_wlan_cold_command(npu, 0x10 | ifindex, func_id,
+						  data, data_len);
+	}
+	if (priv->checked_pair && func_id == WLAN_FUNC_SET_WAIT_TX_BUF_SPACE_HW_BASE) {
+		if (ifindex < 0 || ifindex > 15 ||
+		    npu_cold_txbuf_step(ifindex) == NPU_COLD_TXBUF_STEPS)
+			return -EINVAL;
+		return airoha_npu_wlan_cold_command(npu, 0x10 | ifindex, func_id,
+						  data, data_len);
+	}
+	if (priv->checked_pair && func_id == WLAN_FUNC_SET_WAIT_RX_RING_FOR_TXDONE_HW_BASE) {
+		if (ifindex)
+			return -EINVAL;
+		return airoha_npu_wlan_cold_command(npu, 0x10, func_id,
+						  data, data_len);
+	}
+	if (priv->checked_pair &&
+	    ((ifindex == 0 && func_id == WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE) ||
+	     ((ifindex == 0 || ifindex == 2 || (ifindex >= 5 && ifindex <= 8)) &&
+	      func_id == WLAN_FUNC_SET_WAIT_DESC) ||
+	     (ifindex == 10 && func_id == WLAN_FUNC_SET_WAIT_DESC) ||
+	     ((ifindex == 0 || ifindex == 2 || ifindex == 10 || ifindex == 15) &&
+	      func_id == WLAN_FUNC_SET_WAIT_PCIE_ADDR) ||
+	     (ifindex >= 5 && ifindex <= 8 && func_id == WLAN_FUNC_SET_WAIT_PCIE_ADDR) ||
+	     ((ifindex == 0 || ifindex == 2 || ifindex == 3) &&
+	      func_id == WLAN_FUNC_SET_WAIT_TX_RING_PCIE_ADDR) ||
+	     (ifindex == 0 && func_id == WLAN_FUNC_SET_WAIT_TOKEN_ID_SIZE)))
+		return airoha_npu_wlan_cold_command(npu, 0x10 | ifindex, func_id,
+						  data, data_len);
+	return airoha_npu_wlan_msg_send(npu, ifindex, func_id, data, data_len, gfp);
+}
+
+static int airoha_npu_wlan_msg_get_session(struct airoha_npu *npu, int ifindex,
+					   enum airoha_npu_wlan_get_cmd func_id,
+					   void *data, int data_len, gfp_t gfp)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+
+	/* Probe's early version query precedes session publication and stays raw. */
+	if (priv->checked_pair && READ_ONCE(priv->wlan_session_attempted) &&
+	    ifindex == 0 && func_id == WLAN_FUNC_GET_WAIT_NPU_VERSION)
+		return airoha_npu_wlan_cold_command(npu, 0x30, func_id, data, data_len);
+	if (priv->checked_pair && func_id == WLAN_FUNC_GET_WAIT_RXDESC_BASE) {
+		if (ifindex < 0 || ifindex > 15 ||
+		    npu_cold_descriptor_step(ifindex) == NPU_COLD_DESCRIPTOR_STEPS)
+			return -EINVAL;
+		return airoha_npu_wlan_cold_command(npu, 0x30 | ifindex, func_id,
+						  data, data_len);
+	}
+	return airoha_npu_wlan_msg_get(npu, ifindex, func_id, data, data_len, gfp);
+}
+
+static int airoha_npu_wlan_prepare_memory(struct airoha_npu_priv *priv,
+					  struct resource *regions,
+					  unsigned int *region_count)
+{
+	static const char * const names[] = { "tx-bufid", "pkt", "tx-pkt", "ba" };
+	struct resource memory[ARRAY_SIZE(names)] = {};
+	struct device *dev = priv->npu.dev;
+	unsigned int i, j, count = ARRAY_SIZE(memory);
+	int err;
+
+	*region_count = 0;
+	if (!airoha_npu_memory_valid(&priv->firmware_region))
+		return -EINVAL;
+	if (of_property_match_string(dev->of_node, "memory-region-names", "ba") < 0)
+		count--;
+	/* Commit a complete plan only after every region has passed preflight. */
+	for (i = 0; i < count; i++) {
+		struct resource *res = &memory[i];
+
+		err = of_reserved_mem_region_to_resource_byname(dev->of_node,
+								names[i], res);
+		if (err)
+			return err;
+		if (!airoha_npu_memory_valid(res))
+			return dev_err_probe(dev, -EINVAL,
+					     "invalid NPU %s memory region\n", names[i]);
+		if (priv->txbuf_min_size &&
+		    (res->start < 0x80000000ULL || res->end >= 0xc0000000ULL))
+			return dev_err_probe(dev, -ERANGE,
+					     "NPU %s memory outside firmware DRAM window\n",
+					     names[i]);
+		if (resource_overlaps(res, &priv->firmware_region))
+			return dev_err_probe(dev, -EINVAL,
+					     "NPU %s memory overlaps firmware\n", names[i]);
+		for (j = 0; j < i; j++)
+			if (resource_overlaps(res, &memory[j]))
+				return dev_err_probe(dev, -EINVAL,
+						     "overlapping NPU %s memory region\n",
+						     names[i]);
+	}
+	if (resource_size(&memory[0]) < priv->txbuf_min_size)
+		return dev_err_probe(dev, -EINVAL, "NPU tx-bufid memory region too small\n");
+
+	memcpy(regions, memory, sizeof(memory));
+	*region_count = count;
+
 	return 0;
 }
 
+static int airoha_npu_wlan_prepare_request(struct airoha_npu_priv *priv)
+{
+	struct airoha_npu_core *core = &priv->npu.cores[0];
+	struct resource request = {};
+	unsigned int i;
+
+	/* The native transport pins the coherent mailbox's DMA address, not
+	 * the source pointer or a test fixture. Geometry is not containment.
+	 */
+	if (!core->buf)
+		return -EINVAL;
+	if (core->mbox_pending)
+		return -EBUSY;
+	if (!IS_ALIGNED(core->addr, sizeof(u32)))
+		return -EINVAL;
+	if (core->addr < 0x80000000ULL ||
+	    core->addr > 0xc0000000ULL - AIROHA_NPU_MBOX_SIZE)
+		return -ERANGE;
+	request.start = core->addr;
+	request.end = request.start + AIROHA_NPU_MBOX_SIZE - 1;
+	if (resource_overlaps(&request, &priv->firmware_region))
+		return -EINVAL;
+	for (i = 0; i < priv->wlan_memory_count; i++)
+		if (resource_overlaps(&request, &priv->wlan_memory[i]))
+			return -EINVAL;
+
+	priv->wlan_request = request;
+	priv->wlan_request_valid = true;
+	/* Optional-BA legacy profiles cannot supply the six-region native ABI.
+	 * This private snapshot is not yet an SRAM/boot-identity publication.
+	 */
+	if (priv->wlan_memory_count != 4 ||
+	    priv->firmware_region.start != 0x84000000ULL ||
+	    priv->firmware_region.end >= 0xc0000000ULL)
+		return 0;
+	priv->native_plan[0][0] = priv->firmware_region.start;
