+static void airoha_npu_wlan_session_close(void *data)
+{
+	struct airoha_npu_priv *priv = data;
+
+	/* Join this setup's CPU calls, not independent users or physical DMA. */
+	mutex_lock(&priv->wlan_session_lock);
+	priv->wlan_session_attempted = true;
+	if (!priv->wlan_session_error)
+		priv->wlan_session_error = -ESHUTDOWN;
+	npu_linux_control_close(&priv->wlan_control);
+	mutex_unlock(&priv->wlan_session_lock);
+}
+
+static int airoha_npu_wlan_init_session(struct airoha_npu *npu)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+	u64 nonce = 0;
+	int err, attempt;
+
+	if (!priv->checked_pair)
+		return airoha_npu_wlan_init_memory(npu);
+
+	mutex_lock(&priv->wlan_session_lock);
+	if (priv->wlan_session_attempted) {
+		err = priv->wlan_session_error ?: -EBUSY;
+		goto unlock;
+	}
+	/* A new consumer is not a new boot. Consume this lane before any action. */
+	priv->wlan_session_attempted = true;
+	if (!priv->firmware_loaded || !priv->boot_attempted ||
+	    !priv->native_plan_ready || !priv->native_published ||
+	    !priv->boot_identity || !priv->dma_lifetime ||
+	    !priv->dma_lifetime->exposed || priv->wlan_memory_count != 4) {
+		err = -EINVAL;
+		goto hold;
+	}
+	for (attempt = 0; attempt < 3 && !nonce; attempt++) {
+		err = get_random_bytes_wait(&nonce, sizeof(nonce));
+		if (err)
+			goto hold;
+	}
+	if (!nonce) {
+		err = -EAGAIN;
+		goto hold;
+	}
+	err = npu_linux_control_init(&priv->wlan_control, npu,
+				     lower_32_bits(nonce), upper_32_bits(nonce));
+	if (err)
+		goto hold;
+	err = npu_linux_control_exchange(&priv->wlan_control, NPU_CONTROL_DISCOVER);
+	if (err)
+		goto hold;
+	err = airoha_npu_wlan_session_snapshot(priv, false);
+	if (err)
+		goto hold;
+	err = airoha_npu_wlan_init_memory(npu);
+	if (err)
+		goto hold;
+	err = npu_linux_control_exchange(&priv->wlan_control, NPU_CONTROL_BIND);
+	if (err)
+		goto hold;
+	err = airoha_npu_wlan_session_snapshot(priv, false);
+	if (err)
+		goto hold;
+	err = npu_linux_control_exchange(&priv->wlan_control, NPU_CONTROL_STOP);
+	if (err)
+		goto hold;
+	for (attempt = 0; attempt < 100; attempt++) {
+		err = airoha_npu_wlan_session_snapshot(priv, true);
+		if (!err)
+			goto unlock;
+		if (err != -EAGAIN)
+			goto hold;
+		usleep_range(1000, 2000);
+		err = npu_linux_control_exchange(&priv->wlan_control, NPU_CONTROL_STATUS);
+		if (err)
+			goto hold;
+	}
+	err = airoha_npu_wlan_session_snapshot(priv, true);
+	if (err == -EAGAIN)
+		err = -ETIMEDOUT;
+	if (!err)
+		goto unlock;
+hold:
+	priv->wlan_session_error = err < 0 ? err : -EIO;
+	npu_linux_control_close(&priv->wlan_control);
+	err = priv->wlan_session_error;
+unlock:
+	mutex_unlock(&priv->wlan_session_lock);
+
+	return err;
 }
 
