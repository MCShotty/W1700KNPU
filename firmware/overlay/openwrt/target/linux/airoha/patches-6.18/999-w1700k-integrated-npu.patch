Subject: [PATCH] W1700K: merge NPU ownership, recovery and control changes

Rebased onto the pinned non-OC source. This is the experimental
build input; compilation is not a physical drain or recovery proof.

---
--- a/drivers/clk/clk-en7523.c
+++ b/drivers/clk/clk-en7523.c
@@ -1034,14 +1034,12 @@
 
 	/* For PCIC reset logic is inverted, 0:assert 1:deassert*/
 	if (addr == REG_NP_SCU_PCIC)
-		val |= assert ? 0 : BIT(id % RST_NR_PER_BANK);
+		val = assert ? 0 : BIT(id % RST_NR_PER_BANK);
 	else
-		val |= assert ? BIT(id % RST_NR_PER_BANK) : 0;
-
-	regmap_update_bits(rst_data->map, addr, BIT(id % RST_NR_PER_BANK),
-			   val);
-
-	return 0;
+		val = assert ? BIT(id % RST_NR_PER_BANK) : 0;
+
+	return regmap_update_bits(rst_data->map, addr, BIT(id % RST_NR_PER_BANK),
+				  val);
 }
 
 static int en7523_reset_assert(struct reset_controller_dev *rcdev,
@@ -1063,12 +1061,15 @@
 	u32 addr = rst_data->bank_ofs[id / RST_NR_PER_BANK];
 	bool inverted = false;
 	u32 val;
+	int ret;
 
 	/* For PCIC reset logic is inverted, 0:assert 1:deassert*/
