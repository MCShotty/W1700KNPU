+static int airoha_npu_wlan_session_snapshot(struct airoha_npu_priv *priv,
+					    bool parked)
+{
+	struct npu_linux_control_snapshot snapshot;
+	struct npu_control_client *client = &snapshot.client.base;
+	int err;
+
+	err = npu_linux_control_snapshot(&priv->wlan_control, &snapshot);
+	if (err)
+		return err;
+	if (snapshot.error || snapshot.closed ||
+	    snapshot.client.boot_lo != lower_32_bits(priv->boot_identity) ||
+	    snapshot.client.boot_hi != upper_32_bits(priv->boot_identity) ||
+	    client->epoch != 1 || client->released || client->armed ||
+	    client->ready_mask || client->drain_mask)
+		return -EPROTO;
+	if (parked && (client->phase != NPU_CLIENT_PARKED ||
+		       client->parked_mask != 0xff))
+		return -EAGAIN;
+
+	return 0;
+}
