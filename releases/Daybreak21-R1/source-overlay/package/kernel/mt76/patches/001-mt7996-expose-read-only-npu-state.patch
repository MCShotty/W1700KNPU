+#ifdef CONFIG_MT7996_NPU
+static int mt7996_npu_state_show(struct seq_file *file, void *data)
+{
+	struct mt7996_dev *dev = file->private;
+	struct mt76_dev *mdev = &dev->mt76;
+
+	seq_printf(file, "provider_attached: %u\n",
+		   mt76_npu_device_active(mdev));
+	seq_printf(file, "ppe_attached: %u\n",
+		   mt76_ppe_device_active(mdev));
+	seq_printf(file, "hwrro_mode: %u\n", mdev->hwrro_mode);
+	seq_printf(file, "rx_token_size: %u\n", mdev->rx_token_size);
+	seq_printf(file, "npu_type: %d\n", mdev->mmio.npu_type);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mt7996_npu_state);
