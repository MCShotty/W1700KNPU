+function wifiFrequencyMatchesBand(frequency, band) {
+	let mhz = +frequency;
+
+	if (!Number.isFinite(mhz) || mhz <= 0)
+		return false;
+	if (mhz < 100)
+		mhz *= 1000;
+
+	switch (band) {
+	case '2g': return mhz >= 2400 && mhz < 2500;
+	case '5g': return mhz >= 4900 && mhz < 5925;
+	case '6g': return mhz >= 5925 && mhz <= 7125;
+	}
+
+	return true;
+}
+
+function wifiChannelMatchesBand(channel, band) {
+	const n = +channel;
+
+	if (!Number.isInteger(n) || n <= 0)
+		return false;
+
+	switch (band) {
+	case '2g': return n >= 1 && n <= 14;
+	case '5g': return n >= 1 && n <= 200;
+	case '6g': return n == 2 || (n <= 233 && (n - 1) % 4 == 0);
+	}
+
+	return true;
+}
