+function format_exception(e)
+{
+	let text;
+	if (type(e) == "object" && e.message != null) {
+		text = e.type ? `${e.type}: ${e.message}` : `${e.message}`;
+	} else if (type(e) == "object" || type(e) == "array") {
+		text = sprintf("%.J", e);
+	} else {
+		text = `${e}`;
+	}
+
+	let context = e?.stacktrace?.[0]?.context;
+	return context != null ? `${text}\n${context}` : text;
+}
+
+function log_exception(prefix, e)
+{
+	let text;
+	try {
+		text = format_exception(e);
+	} catch (format_error) {
+		text = "unprintable exception";
+	}
+
+	try {
+		for (let line in split(`${prefix}${text}`, '\n'))
+			hostapd.printf(line);
+	} catch (log_error) {
+	}
+}
+
