From: W1700K stock-port work
Subject: [PATCH] mt76: mt7996: keep both NPU TX queues with one HIF

The MT7996 NPU attachment programs two physical TX rings regardless
of the second HIF. Descriptor setup writes the first base through
PHY1 and the second through PHY0. Sharing PHY1 with PHY0 without HIF2
leaves TX1 unpublished and overwrites the first physical base.

Select the NPU mapping before the HIF branch and retain two queue
owners. HIF2 still selects the PCIe offset for the primary queue.
Non-NPU operation and other chip families are unchanged.

This corrects the host TX contract only. It does not establish firmware
readiness, containment, failure cleanup, or working single-HIF hardware.
---
--- a/mt7996/dma.c
+++ b/mt7996/dma.c
@@ -128,23 +128,21 @@ static void mt7996_dma_config(struct mt7996_dev *dev)
 
 	/* data tx queue */
 	if (is_mt7996(&dev->mt76)) {
-		if (dev->hif2) {
-			if (mt76_npu_device_active(&dev->mt76)) {
-				TXQ_CONFIG(0, WFDMA0, MT_INT_TX_DONE_BAND2,
-					   MT7996_TXQ_BAND2);
-				TXQ_CONFIG(1, WFDMA0, MT_INT_TX_DONE_BAND0,
-					   MT7996_TXQ_BAND0);
-				TXQ_CONFIG(2, WFDMA0, MT_INT_TX_DONE_BAND1,
-					   MT7996_TXQ_BAND1);
-			} else {
-				/* default bn1:ring19 bn2:ring21 */
-				TXQ_CONFIG(0, WFDMA0, MT_INT_TX_DONE_BAND0,
-					   MT7996_TXQ_BAND0);
-				TXQ_CONFIG(1, WFDMA0, MT_INT_TX_DONE_BAND1,
-					   MT7996_TXQ_BAND1);
-				TXQ_CONFIG(2, WFDMA0, MT_INT_TX_DONE_BAND2,
-					   MT7996_TXQ_BAND2);
-			}
+		if (mt76_npu_device_active(&dev->mt76)) {
+			TXQ_CONFIG(0, WFDMA0, MT_INT_TX_DONE_BAND2,
+				   MT7996_TXQ_BAND2);
+			TXQ_CONFIG(1, WFDMA0, MT_INT_TX_DONE_BAND0,
+				   MT7996_TXQ_BAND0);
+			TXQ_CONFIG(2, WFDMA0, MT_INT_TX_DONE_BAND1,
+				   MT7996_TXQ_BAND1);
+		} else if (dev->hif2) {
+			/* default bn1:ring19 bn2:ring21 */
+			TXQ_CONFIG(0, WFDMA0, MT_INT_TX_DONE_BAND0,
+				   MT7996_TXQ_BAND0);
+			TXQ_CONFIG(1, WFDMA0, MT_INT_TX_DONE_BAND1,
+				   MT7996_TXQ_BAND1);
+			TXQ_CONFIG(2, WFDMA0, MT_INT_TX_DONE_BAND2,
+				   MT7996_TXQ_BAND2);
 		} else {
 			/* single pcie bn0/1:ring18 bn2:ring19 */
 			TXQ_CONFIG(0, WFDMA0, MT_INT_TX_DONE_BAND0,
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -760,7 +760,8 @@ static int mt7996_register_phy(struct mt7996_dev *dev, enum mt76_band_id band)
 	mt7996_init_wiphy_band(mphy->hw, phy);
 
 	if (is_mt7996(&dev->mt76) &&
-	    ((band == MT_BAND1 && !dev->hif2) ||
+	    ((band == MT_BAND1 && !dev->hif2 &&
+	      !mt76_npu_device_active(&dev->mt76)) ||
 	     (band == MT_BAND2 && mt76_npu_device_active(&dev->mt76)))) {
 		int i;
 
