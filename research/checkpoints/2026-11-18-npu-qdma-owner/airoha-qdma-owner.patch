+static void airoha_qdma_free_unexposed(struct airoha_qdma *qdma,
+				       struct device *dev)
+{
+	struct airoha_qdma_table *table, *next;
+	int i;
+
+	list_for_each_entry_safe(table, next, &qdma->dma_tables, list) {
+		dma_free_coherent(dev, table->bytes, table->va, table->dma);
+		list_del(&table->list);
+		kfree(table);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++) {
+		kfree(qdma->q_rx[i].entry);
+		qdma->q_rx[i].entry = NULL;
+	}
+	for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
+		kfree(qdma->q_tx[i].entry);
+		qdma->q_tx[i].entry = NULL;
+	}
+}
+
+static void airoha_qdma_release_owner(void *data)
+{
+	struct airoha_eth *eth = data;
+	bool retain = false;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		if (eth->qdma[i].dma_exposed)
+			retain = true;
+		else
+			airoha_qdma_free_unexposed(&eth->qdma[i], eth->dev);
+	}
+
+	/* Host idle does not retire forwarding or all descriptor backing. */
+	if (retain) {
+		dev_warn(eth->dev, "QDMA retirement unverified; retaining DMA memory\n");
+		return;
+	}
+
+	mutex_lock(&airoha_qdma_owner_lock);
+	w1700k_qdma_owner = NULL;
+	mutex_unlock(&airoha_qdma_owner_lock);
+	put_device(eth->dev);
+	kfree(eth);
+	module_put(THIS_MODULE);
+}
+
+static struct airoha_eth *airoha_alloc_eth(struct device *dev)
+{
+	struct airoha_eth *eth;
+	int i, err;
+
+	if (!of_machine_is_compatible("gemtek,w1700k-ubi")) {
+		eth = devm_kzalloc(dev, sizeof(*eth), GFP_KERNEL);
+		return eth ?: ERR_PTR(-ENOMEM);
+	}
+
+	/* This owner does not retain an IOMMU domain or a device DMA pool. */
+	if (device_iommu_mapped(dev) || get_dma_ops(dev))
+		return ERR_PTR(-EOPNOTSUPP);
+#ifdef CONFIG_DMA_DECLARE_COHERENT
+	if (dev->dma_mem)
+		return ERR_PTR(-EOPNOTSUPP);
+#endif
+
+	eth = kzalloc(sizeof(*eth), GFP_KERNEL);
+	if (!eth)
+		return ERR_PTR(-ENOMEM);
+
+	mutex_lock(&airoha_qdma_owner_lock);
+	if (w1700k_qdma_owner) {
+		err = -EBUSY;
+		goto unlock;
+	}
+	if (!try_module_get(THIS_MODULE)) {
+		err = -ENODEV;
+		goto unlock;
+	}
+
+	eth->dev = get_device(dev);
+	eth->owns_qdma = true;
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
+		INIT_LIST_HEAD(&eth->qdma[i].dma_tables);
+	w1700k_qdma_owner = eth;
+	mutex_unlock(&airoha_qdma_owner_lock);
+
+	err = devm_add_action_or_reset(dev, airoha_qdma_release_owner, eth);
+	return err ? ERR_PTR(err) : eth;
+
+unlock:
+	mutex_unlock(&airoha_qdma_owner_lock);
+	kfree(eth);
+	return ERR_PTR(err);
+}
+
+static void *airoha_qdma_alloc_table(struct airoha_qdma *qdma, size_t bytes,
+				     dma_addr_t *dma)
+{
+	struct airoha_eth *eth = qdma->eth;
+	struct airoha_qdma_table *table;
+
+	if (!eth->owns_qdma)
+		return dmam_alloc_coherent(eth->dev, bytes, dma, GFP_KERNEL);
+
+	table = kmalloc(sizeof(*table), GFP_KERNEL);
+	if (!table)
+		return NULL;
+
+	table->va = dma_alloc_coherent(eth->dev, bytes, &table->dma, GFP_KERNEL);
+	if (!table->va) {
+		kfree(table);
+		return NULL;
+	}
+	table->bytes = bytes;
+	list_add_tail(&table->list, &qdma->dma_tables);
+	*dma = table->dma;
+	return table->va;
+}
+
+static void *airoha_qdma_alloc_entries(struct airoha_qdma *qdma, int ndesc)
+{
+	size_t size = sizeof(struct airoha_queue_entry);
+
+	if (qdma->eth->owns_qdma)
+		return kcalloc(ndesc, size, GFP_KERNEL);
+	return devm_kcalloc(qdma->eth->dev, ndesc, size, GFP_KERNEL);
+}
+
+static void airoha_qdma_publish_base(struct airoha_qdma *qdma, u32 reg,
+				     dma_addr_t addr)
+{
+	if (qdma->eth->owns_qdma)
+		qdma->dma_exposed = true;
+	airoha_qdma_wr(qdma, reg, addr);
+}
