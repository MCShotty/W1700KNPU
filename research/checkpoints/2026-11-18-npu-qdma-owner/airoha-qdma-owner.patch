+static void airoha_qdma_detach_tx_dev(struct airoha_qdma *qdma,
+				      struct net_device *netdev)
+{
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(qdma->q_tx); i++) {
+		struct airoha_queue *q = &qdma->q_tx[i];
+
+		if (!q->ndesc)
+			continue;
+
+		spin_lock_bh(&q->lock);
+		for (j = 0; j < q->ndesc; j++) {
+			struct airoha_queue_entry *e = &q->entry[j];
+			struct sk_buff *skb = e->skb;
+
+			if (!e->dma_addr || !skb || e->tx_dev != netdev)
+				continue;
+
+			/* Detach Linux bookkeeping without releasing DMA data. */
+			skb_orphan(skb);
+			skb_scrub_packet(skb, true);
+			skb->dev = NULL;
+			e->tx_dev = NULL;
+		}
+		spin_unlock_bh(&q->lock);
+	}
+}
