+static void airoha_qdma_park(struct airoha_qdma *qdma)
+{
+	int i, j;
+
+	if (qdma->parked)
+		return;
+
+	WRITE_ONCE(qdma->blocked, true);
+	airoha_qdma_stop_napi(qdma);
+
+	if (qdma->dma_exposed) {
+		airoha_qdma_clear(qdma, REG_QDMA_GLOBAL_CFG, AIROHA_QDMA_HOST_EN);
+		airoha_qdma_rr(qdma, REG_QDMA_GLOBAL_CFG);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++) {
+		struct airoha_irq_bank *bank = &qdma->irq_banks[i];
+
+		if (!bank->requested)
+			continue;
+		for (j = 0; j < ARRAY_SIZE(bank->irqmask); j++)
+			airoha_qdma_irq_disable(bank, j, U32_MAX);
+		synchronize_irq(bank->irq);
+	}
+	qdma->parked = true;
+}
+
+static void airoha_hw_stop_napi(struct airoha_eth *eth)
+{
+	int i;
+
+	if (eth->owns_qdma) {
+		rtnl_lock();
+		mutex_lock(&flow_offload_mutex);
+		set_bit(DEV_STATE_QDMA_DETACH, &eth->state);
+		mutex_unlock(&flow_offload_mutex);
+		rtnl_unlock();
+		synchronize_rcu();
+	}
+
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		if (eth->owns_qdma)
+			airoha_qdma_park(&eth->qdma[i]);
+		else
+			airoha_qdma_stop_napi(&eth->qdma[i]);
+	}
 }

