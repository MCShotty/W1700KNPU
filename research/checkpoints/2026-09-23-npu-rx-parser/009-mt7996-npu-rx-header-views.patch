 			mt7996_mac_add_txs(dev, rxd);
 		dev_kfree_skb(skb);
@@ -1735,6 +1826,7 @@
 		}
 		fallthrough;
 	default:
+free_skb:
 		dev_kfree_skb(skb);
 		break;
 	}
