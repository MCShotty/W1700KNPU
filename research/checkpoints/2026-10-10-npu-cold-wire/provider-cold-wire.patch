Subject: [PATCH] net: airoha: route checked initial cold commands

Reuse the provider session and serialize the dedicated cold envelope.
No DMA retirement, physical containment or full offload is implied.

---
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -378,12 +378,15 @@
 		return -ENODEV;
 	if (!data || len != 80)
 		return -EINVAL;
-	/* Dedicated NQC2 envelope: WLAN GET selector 15, API 0. */
+	/* Dedicated control/cold envelopes, never a generic legacy callback. */
 	if (get_unaligned_le32(bytes) != 0x3f ||
-	    get_unaligned_le32(bytes + 4) != 0 ||
-	    get_unaligned_le32(bytes + 8) != 0x3243514e ||
 	    get_unaligned_le32(bytes + 12) != 2 ||
 	    get_unaligned_le32(bytes + 16) != 80)
+		return -EINVAL;
+	if (!((get_unaligned_le32(bytes + 4) == 0 &&
+	       get_unaligned_le32(bytes + 8) == 0x3243514e) ||
+	      (get_unaligned_le32(bytes + 4) == NPU_COLD_API &&
+	       get_unaligned_le32(bytes + 8) == NPU_COLD_REQUEST)))
 		return -EINVAL;
 
 	/* The coherent bounce buffer, including timeout retention, owns the
@@ -940,6 +943,66 @@
 	return err;
 }
 
+static int airoha_npu_wlan_cold_command(struct airoha_npu *npu, u32 header,
+					u32 api, void *data, int len)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+	struct npu_bootstrap_packet command = { .header = header, .api = api };
+	u32 value;
+	int err;
+
+	if (!data || len != sizeof(value))
+		return -EINVAL;
+	if (header != 0x30)
+		command.value = get_unaligned_le32(data);
+	mutex_lock(&priv->wlan_session_lock);
+	if (priv->wlan_session_error) {
+		err = priv->wlan_session_error;
+		goto unlock;
+	}
+	if (!priv->wlan_session_attempted || !priv->wlan_control.initialized) {
+		err = -EINVAL;
+		goto unlock;
+	}
+	err = npu_linux_control_cold_exchange(&priv->wlan_control, &command, &value);
+	if (err) {
+		priv->wlan_session_error = err;
+		npu_linux_control_close(&priv->wlan_control);
+	} else if (header == 0x30) {
+		put_unaligned_le32(value, data);
+	}
+unlock:
+	mutex_unlock(&priv->wlan_session_lock);
+	return err;
+}
+
+static int airoha_npu_wlan_msg_send_session(struct airoha_npu *npu, int ifindex,
+					    enum airoha_npu_wlan_set_cmd func_id,
+					    void *data, int data_len, gfp_t gfp)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+
+	if (priv->checked_pair &&
+	    ((ifindex == 0 && func_id == WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE) ||
+	     ((ifindex == 0 || ifindex == 2) && func_id == WLAN_FUNC_SET_WAIT_DESC)))
+		return airoha_npu_wlan_cold_command(npu, 0x10 | ifindex, func_id,
+						  data, data_len);
+	return airoha_npu_wlan_msg_send(npu, ifindex, func_id, data, data_len, gfp);
+}
+
+static int airoha_npu_wlan_msg_get_session(struct airoha_npu *npu, int ifindex,
+					   enum airoha_npu_wlan_get_cmd func_id,
+					   void *data, int data_len, gfp_t gfp)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+
+	/* Probe's early version query precedes session publication and stays raw. */
+	if (priv->checked_pair && READ_ONCE(priv->wlan_session_attempted) &&
+	    ifindex == 0 && func_id == WLAN_FUNC_GET_WAIT_NPU_VERSION)
+		return airoha_npu_wlan_cold_command(npu, 0x30, func_id, data, data_len);
+	return airoha_npu_wlan_msg_get(npu, ifindex, func_id, data, data_len, gfp);
+}
+
 static int airoha_npu_wlan_prepare_memory(struct airoha_npu_priv *priv,
 					  struct resource *regions,
 					  unsigned int *region_count)
@@ -1412,8 +1475,8 @@
 	npu->ops.ppe_flush_sram_entries = airoha_npu_ppe_flush_sram_entries;
 	npu->ops.ppe_foe_commit_entry = airoha_npu_foe_commit_entry;
 	npu->ops.wlan_init_reserved_memory = airoha_npu_wlan_init_session;
-	npu->ops.wlan_send_msg = airoha_npu_wlan_msg_send;
-	npu->ops.wlan_get_msg = airoha_npu_wlan_msg_get;
+	npu->ops.wlan_send_msg = airoha_npu_wlan_msg_send_session;
+	npu->ops.wlan_get_msg = airoha_npu_wlan_msg_get_session;
 	npu->ops.wlan_get_queue_addr = airoha_npu_wlan_queue_addr_get;
 	npu->ops.wlan_set_irq_status = airoha_npu_wlan_irq_status_set;
 	npu->ops.wlan_get_irq_status = airoha_npu_wlan_irq_status_get;
--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -8,8 +8,9 @@
 airoha-eth-$(CONFIG_DEBUG_FS) += airoha_ppe_debugfs.o
 obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
 airoha_npu-y := w1700k/provider-main.o w1700k/control-client.o \
-		w1700k/control-v2-client.o w1700k/linux-control.o
+		w1700k/control-v2-client.o w1700k/cold-client.o w1700k/linux-control.o
 CFLAGS_w1700k/provider-main.o := -I$(src)/w1700k/kernel-include
 CFLAGS_w1700k/control-client.o := -I$(src)/w1700k/kernel-include
 CFLAGS_w1700k/control-v2-client.o := -I$(src)/w1700k/kernel-include
+CFLAGS_w1700k/cold-client.o := -I$(src)/w1700k/kernel-include
 CFLAGS_w1700k/linux-control.o := -I$(src)/w1700k/kernel-include
--- a/drivers/net/ethernet/airoha/w1700k/linux-control.c
+++ b/drivers/net/ethernet/airoha/w1700k/linux-control.c
@@ -107,6 +107,44 @@
 	return 0;
 }
 
+int npu_linux_control_cold_exchange(struct npu_linux_control *control,
+				    const struct npu_bootstrap_packet *command,
+				    u32 *value)
+{
+	struct npu_bootstrap_packet snapshot;
+	struct npu_cold_packet packet;
+	enum npu_client_result result;
+	u32 ticket;
+	int error;
+
+	if (!control || !control->initialized || !command || !value)
+		return -EINVAL;
+	mutex_lock(&control->mutex);
+	if (control->error) {
+		error = control->error;
+		goto unlock;
+	}
+	if (control->closed || !control->provider) {
+		error = hold(control, -ESHUTDOWN);
+		goto unlock;
+	}
+	snapshot = *command;
+	ticket = npu_cold_client_request(&control->client, &packet,
+					 sizeof(packet), &snapshot);
+	if (!ticket) {
+		error = hold(control, -EPROTO);
+		goto unlock;
+	}
+	error = airoha_npu_wlan_control(control->provider, &packet, sizeof(packet));
+	result = npu_cold_client_complete(&control->client, ticket, error,
+					  &packet, sizeof(packet), &snapshot, value);
+	if (error || result != NPU_CLIENT_ACCEPTED)
+		error = hold(control, error < 0 ? error : error ? -EIO : -EPROTO);
+unlock:
+	mutex_unlock(&control->mutex);
+	return error;
+}
+
 void npu_linux_control_close(struct npu_linux_control *control)
 {
 	if (!control || !control->initialized)
--- a/drivers/net/ethernet/airoha/w1700k/linux-control.h
+++ b/drivers/net/ethernet/airoha/w1700k/linux-control.h
@@ -4,6 +4,7 @@
 #include <linux/mutex.h>
 #include <linux/types.h>
 #include "control-v2.h"
+#include "cold-setup.h"
 
 struct airoha_npu;
 
@@ -37,6 +38,9 @@
 			       enum npu_control_operation operation);
 int npu_linux_control_snapshot(struct npu_linux_control *control,
 			       struct npu_linux_control_snapshot *snapshot);
+int npu_linux_control_cold_exchange(struct npu_linux_control *control,
+				    const struct npu_bootstrap_packet *command,
+				    u32 *value);
 void npu_linux_control_close(struct npu_linux_control *control);
 
 #endif
