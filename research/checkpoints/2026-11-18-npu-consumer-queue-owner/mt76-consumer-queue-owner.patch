+++ b/dma.c
@@ -840,6 +840,9 @@ mt76_dma_alloc_queue(struct mt76_dev *dev, struct mt76_queue *q,
 {
 	int ret, size;
 
+	if (q->desc || q->entry)
+		return -EBUSY;
+
 	spin_lock_init(&q->lock);
 	spin_lock_init(&q->cleanup_lock);
 
@@ -858,25 +861,26 @@ mt76_dma_alloc_queue(struct mt76_dev *dev, struct mt76_queue *q,
 	else
 		size = sizeof(struct mt76_desc);
 
-	ret = mt76_npu_alloc_rx_event(dev, q);
-	if (ret == -EOPNOTSUPP)
+	ret = mt76_npu_alloc_queue_mem(dev, q, size);
+	if (ret == MT76_NPU_QUEUE_MEM_MANAGED) {
 		q->desc = dmam_alloc_coherent(dev->dma_dev, q->ndesc * size,
 					      &q->desc_dma, GFP_KERNEL);
-	else if (ret)
-		return ret;
-	if (!q->desc)
-		return -ENOMEM;
-
-	mt76_dma_queue_magic_cnt_init(dev, q);
-	size = q->ndesc * sizeof(*q->entry);
-	q->entry = devm_kzalloc(dev->dev, size, GFP_KERNEL);
-	if (!q->entry)
-		return -ENOMEM;
+		if (q->desc)
+			q->entry = devm_kcalloc(dev->dev, q->ndesc,
+					       sizeof(*q->entry), GFP_KERNEL);
+	} else if (ret) {
+		goto clear_count;
+	}
+	if (!q->desc || !q->entry) {
+		ret = -ENOMEM;
+		goto clear_count;
+	}
 
 	ret = mt76_create_page_pool(dev, q);
 	if (ret)
-		return ret;
+		goto clear_count;
 
+	mt76_dma_queue_magic_cnt_init(dev, q);
 	mt76_npu_queue_setup(dev, q);
 	ret = mt76_wed_dma_setup(dev, q, false);
 	if (ret)
@@ -894,6 +898,11 @@ mt76_dma_alloc_queue(struct mt76_dev *dev, struct mt76_queue *q,
 	mt76_dma_queue_reset(dev, q, !mt76_queue_is_emi(q));
 
 	return 0;
+
+clear_count:
+	/* No consumer register was published for this incomplete queue. */
+	q->ndesc = 0;
+	return ret;
 }
 
