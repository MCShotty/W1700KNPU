 					  life->tx_buffers[i].buf,
 					  life->tx_buffers[i].addr);
+	if (life->rx_event.buf)
+		dma_free_coherent(life->dev, life->rx_event.bytes,
+				  life->rx_event.buf, life->rx_event.addr);
 	if (life->endpoint)
 		put_device(life->endpoint);
 	put_device(life->dev);
@@ -1055,6 +1066,13 @@
 		return false;
 	if (base < bar + life->endpoint_bytes && bar < base + bytes)
 		return false;
+	if (life->rx_event.buf) {
+		u64 other = life->rx_event.addr & 0x3fffffffULL;
+
+		if (life->tx_buffers[index].buf == life->rx_event.buf ||
+		    (base < other + life->rx_event.bytes && other < base + bytes))
+			return false;
+	}
 	for (i = 0; i < NPU_EN7581_7996_PLAN_REGIONS; i++) {
 		u64 other = priv->native_plan[i][0] & 0x3fffffffULL;
 
@@ -1077,6 +1095,170 @@
