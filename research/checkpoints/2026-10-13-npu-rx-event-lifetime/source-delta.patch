+int mt76_npu_alloc_rx_event(struct mt76_dev *dev, struct mt76_queue *q)
+{
+	int qid = is_mt7996(dev) ? MT_RXQ_TXFREE_BAND0 : MT_RXQ_MAIN_WA;
+	struct airoha_npu *npu;
+	dma_addr_t addr;
+	void *buf;
+	int err;
+
+	BUILD_BUG_ON(sizeof(*q->desc) != 16);
+	if (q != &dev->q_rx[qid] || q->flags != MT_NPU_Q_TXFREE(0))
+		return -EOPNOTSUPP;
+	if (q->desc || q->desc_dma)
+		return -EBUSY;
+	mutex_lock(&dev->mutex);
+	npu = rcu_dereference_protected(dev->mmio.npu, &dev->mutex);
+	if (!npu) {
+		err = -ENODEV;
+		goto unlock;
+	}
+	err = airoha_npu_wlan_alloc_rx_event(npu, dev->dev, dev->dma_dev,
+					     q->ndesc, sizeof(*q->desc), &buf, &addr);
+	if (!err) {
+		q->desc = buf;
+		q->desc_dma = addr;
+	}
+unlock:
+	mutex_unlock(&dev->mutex);
+	return err;
+}
+EXPORT_SYMBOL_GPL(mt76_npu_alloc_rx_event);
+
