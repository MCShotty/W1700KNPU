 		u32 bytes;
 	} tx_buffers[6];
+	struct {
+		void *buf;
+		dma_addr_t addr;
+		u32 bytes;
+	} rx_event;
 	struct device *endpoint;
 	u64 boot_identity;
 	u32 nonce_lo, nonce_hi;
@@ -162,6 +167,9 @@
 	bool endpoint_bound;
 	bool tx_attempted;
 	bool tx_published;
+	bool rx_attempted;
+	bool rx_published;
+	u32 rx_serial;
 	bool exposed;
 };
 
