+}
+
+static bool airoha_npu_wlan_rx_event_valid(struct airoha_npu_priv *priv)
+{
+	struct airoha_npu_dma_lifetime *life = priv->dma_lifetime;
+	u64 addr = life->rx_event.addr, base = addr & 0x3fffffffULL;
+	u64 bar = life->endpoint_base & 0x3fffffffULL;
+	u32 bytes = life->rx_event.bytes;
+	unsigned int i;
+
+	if (!life->rx_event.buf || bytes != 512 * 16 || !addr ||
+	    upper_32_bits(addr) || !IS_ALIGNED(addr, 16) || addr >= 0xc0000000ULL ||
+	    bytes > 0xc0000000ULL - addr || bytes > 0x40000000ULL - base ||
+	    (base < bar + life->endpoint_bytes && bar < base + bytes))
+		return false;
+	for (i = 0; i < NPU_EN7581_7996_PLAN_REGIONS; i++) {
+		u64 other = priv->native_plan[i][0] & 0x3fffffffULL;
+
+		if (base < other + priv->native_plan[i][1] && other < base + bytes)
+			return false;
+	}
+	for (i = 0; i < ARRAY_SIZE(life->buffers); i++) {
+		u64 other = life->buffers[i].addr & 0x3fffffffULL;
+
+		if (life->buffers[i].buf &&
+		    (life->rx_event.buf == life->buffers[i].buf ||
+		     (base < other + AIROHA_NPU_MBOX_SIZE && other < base + bytes)))
+			return false;
+	}
+	for (i = 0; i < ARRAY_SIZE(life->tx_buffers); i++) {
+		u64 other = life->tx_buffers[i].addr & 0x3fffffffULL;
+
+		if (life->tx_buffers[i].buf &&
+		    (life->rx_event.buf == life->tx_buffers[i].buf ||
+		     (base < other + life->tx_buffers[i].bytes && other < base + bytes)))
+			return false;
+	}
+	return true;
+}
+
+static int airoha_npu_wlan_alloc_rx_event_session(struct airoha_npu *npu,
+						  struct device *endpoint,
+						  struct device *dma_dev,
+						  u32 count, u32 stride,
+						  void **buf, dma_addr_t *addr)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+	struct airoha_npu_dma_lifetime *life = priv->dma_lifetime;
+	struct npu_linux_control_snapshot snapshot;
+	u32 plan[NPU_EN7581_7996_PLAN_REGIONS][2];
+	struct {
+		void *buf;
+		dma_addr_t addr;
+	} mailboxes[NPU_NUM_CORES];
+	u32 endpoint_base, endpoint_bytes, bound_serial;
+	void *allocated;
+	dma_addr_t allocated_addr;
+	unsigned int i;
+	int err = 0;
+
+	if (!priv->checked_pair)
+		return -EOPNOTSUPP;
+	if (!endpoint || !dma_dev || count != 512 || stride != 16 ||
+	    !buf || !addr)
+		return -EINVAL;
+	mutex_lock(&priv->wlan_session_lock);
+	if (priv->wlan_session_error) {
+		err = priv->wlan_session_error;
+		goto unlock;
+	}
+	if (dma_dev != npu->dev) {
+		err = -EINVAL;
+		goto unlock;
+	}
+	if (!life || life->dev != dma_dev || !life->exposed ||
+	    !life->endpoint_bound || life->endpoint != endpoint || !priv->native_published ||
+	    life->rx_attempted || life->rx_published || life->rx_serial ||
+	    life->rx_event.buf || life->rx_event.addr || life->rx_event.bytes ||
+	    life->tx_attempted || life->tx_published) {
+		err = -EBUSY;
+		goto unlock;
+	}
+	err = airoha_npu_wlan_session_snapshot(priv, true);
+	if (err)
+		goto hold;
+	npu_linux_control_snapshot(&priv->wlan_control, &snapshot);
+	if (life->boot_identity != priv->boot_identity ||
+	    life->nonce_lo != snapshot.client.base.nonce_lo ||
+	    life->nonce_hi != snapshot.client.base.nonce_hi ||
+	    life->bound_serial != snapshot.client.base.serial || snapshot.descriptor_gets ||
+	    snapshot.descriptor_arena || snapshot.txbuf_enrolled || snapshot.txbuf_steps) {
+		err = -EPROTO;
+		goto hold;
+	}
+	memcpy(plan, priv->native_plan, sizeof(plan));
+	endpoint_base = life->endpoint_base;
+	endpoint_bytes = life->endpoint_bytes;
+	bound_serial = life->bound_serial;
+	for (i = 0; i < ARRAY_SIZE(mailboxes); i++) {
+		if (!life->buffers[i].buf || !life->buffers[i].addr ||
+		    upper_32_bits(life->buffers[i].addr)) {
+			err = -EPROTO;
+			goto hold;
+		}
+		mailboxes[i].buf = life->buffers[i].buf;
+		mailboxes[i].addr = life->buffers[i].addr;
+	}
+	/* Retain the real queue backing before any caller can program its address. */
+	life->rx_attempted = true;
+	life->rx_event.bytes = count * stride;
+	life->rx_event.buf = dma_alloc_coherent(dma_dev, life->rx_event.bytes,
+						&life->rx_event.addr, GFP_KERNEL);
+	if (!life->rx_event.buf) {
+		err = -ENOMEM;
+		goto hold;
+	}
+	if (!airoha_npu_wlan_rx_event_valid(priv)) {
+		err = -EINVAL;
+		goto hold;
+	}
+	allocated = life->rx_event.buf;
+	allocated_addr = life->rx_event.addr;
+	err = npu_linux_control_exchange(&priv->wlan_control, NPU_CONTROL_STATUS);
+	if (err)
+		goto hold;
+	err = airoha_npu_wlan_session_snapshot(priv, true);
+	if (err)
+		goto hold;
+	npu_linux_control_snapshot(&priv->wlan_control, &snapshot);
+	if (priv->dma_lifetime != life || life->dev != dma_dev || npu->dev != dma_dev ||
+	    !life->exposed || !life->endpoint_bound || life->endpoint != endpoint ||
+	    !priv->native_published || !life->rx_attempted ||
+	    life->rx_published || life->rx_serial ||
+	    life->tx_attempted || life->tx_published ||
+	    life->boot_identity != priv->boot_identity ||
+	    life->nonce_lo != snapshot.client.base.nonce_lo ||
+	    life->nonce_hi != snapshot.client.base.nonce_hi ||
+	    life->endpoint_base != endpoint_base || life->endpoint_bytes != endpoint_bytes ||
+	    life->bound_serial != bound_serial ||
+	    snapshot.descriptor_gets || snapshot.descriptor_arena ||
+	    snapshot.txbuf_enrolled || snapshot.txbuf_steps ||
+	    life->rx_event.buf != allocated || life->rx_event.addr != allocated_addr ||
+	    memcmp(plan, priv->native_plan, sizeof(plan)) ||
+	    !airoha_npu_wlan_rx_event_valid(priv)) {
+		err = -EPROTO;
+		goto hold;
+	}
+	for (i = 0; i < ARRAY_SIZE(mailboxes); i++)
+		if (life->buffers[i].buf != mailboxes[i].buf ||
+		    life->buffers[i].addr != mailboxes[i].addr) {
+			err = -EPROTO;
+			goto hold;
+		}
+	life->rx_serial = snapshot.client.base.serial;
+	life->rx_published = true;
+	*buf = allocated;
+	*addr = allocated_addr;
+	goto unlock;
+hold:
+	priv->wlan_session_error = err;
+	npu_linux_control_close(&priv->wlan_control);
+unlock:
+	mutex_unlock(&priv->wlan_session_lock);
+	return err;
 }
 
