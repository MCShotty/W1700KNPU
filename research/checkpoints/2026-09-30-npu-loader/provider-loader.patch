Subject: [PATCH] net: airoha: preflight the NPU firmware pair

Obtain and validate both images before replacing code or SRAM.
Reject empty images and release acquired firmware on failure.

---
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -293,27 +293,51 @@
 }
 EXPORT_SYMBOL_GPL(airoha_npu_wlan_control);
 
-static int airoha_npu_load_firmware(struct device *dev, void __iomem *addr,
-				    const char *fw_name, int fw_max_size)
+static int airoha_npu_request_firmware(struct device *dev,
+				       const struct airoha_npu_fw *image,
+				       const struct firmware **result)
 {
 	const struct firmware *fw;
 	int ret;
 
-	ret = request_firmware_direct(&fw, fw_name, dev);
+	ret = request_firmware_direct(&fw, image->name, dev);
 	if (ret)
 		return dev_err_probe(dev, ret == -ENOENT ? -EPROBE_DEFER : ret,
-				     "failed to load %s\n", fw_name);
-
-	if (fw->size > fw_max_size) {
-		dev_err(dev, "%s: fw size too overlimit (%zu)\n",
-			fw_name, fw->size);
-		ret = -E2BIG;
-		goto out;
-	}
-
-	memcpy_toio(addr, fw->data, fw->size);
-out:
-	release_firmware(fw);
+				     "failed to load %s\n", image->name);
+
+	if (!fw->size || fw->size > image->max_size) {
+		dev_err(dev, "%s: invalid fw size (%zu)\n",
+			image->name, fw->size);
+		ret = fw->size ? -E2BIG : -EINVAL;
+		release_firmware(fw);
+		return ret;
+	}
+
+	*result = fw;
+	return 0;
+}
+
+static int airoha_npu_load_firmware(struct device *dev, void __iomem *addr,
+				    void __iomem *base,
+				    const struct airoha_npu_soc_data *images)
+{
+	const struct firmware *rv32, *data;
+	int ret;
+
+	ret = airoha_npu_request_firmware(dev, &images->fw_rv32, &rv32);
+	if (ret)
+		return ret;
+
+	ret = airoha_npu_request_firmware(dev, &images->fw_data, &data);
+	if (ret)
+		goto release_rv32;
+
+	/* A deferred or invalid second image must not replace just the code. */
+	memcpy_toio(addr, rv32->data, rv32->size);
+	memcpy_toio(base + REG_NPU_LOCAL_SRAM, data->data, data->size);
+	release_firmware(data);
+release_rv32:
+	release_firmware(rv32);
 
 	return ret;
 }
@@ -324,6 +348,7 @@
 {
 	struct device *dev = priv->npu.dev;
 	const char *fw_names[2];
+	struct airoha_npu_soc_data images;
 	int ret;
 
 	ret = of_property_read_string_array(dev->of_node, "firmware-name",
@@ -335,14 +360,12 @@
 	if (!strcmp(fw_names[0], NPU_EN7581_7996_FIRMWARE_RV32))
 		priv->txbuf_min_size = NPU_EN7581_7996_TX_CHECK_SIZE;
 
-	ret = airoha_npu_load_firmware(dev, addr, fw_names[0],
-				       NPU_EN7581_FIRMWARE_RV32_MAX_SIZE);
-	if (ret)
-		return ret;
-
-	return airoha_npu_load_firmware(dev, base + REG_NPU_LOCAL_SRAM,
-					fw_names[1],
-					NPU_EN7581_FIRMWARE_DATA_MAX_SIZE);
+	images.fw_rv32.name = fw_names[0];
+	images.fw_rv32.max_size = NPU_EN7581_FIRMWARE_RV32_MAX_SIZE;
+	images.fw_data.name = fw_names[1];
+	images.fw_data.max_size = NPU_EN7581_FIRMWARE_DATA_MAX_SIZE;
+
+	return airoha_npu_load_firmware(dev, addr, base, &images);
 }
 
 static int airoha_npu_run_firmware(struct airoha_npu_priv *priv, void __iomem *base,
@@ -351,7 +374,6 @@
 	struct device *dev = priv->npu.dev;
 	const struct airoha_npu_soc_data *soc;
 	void __iomem *addr;
-	int ret;
 
 	soc = of_device_get_match_data(dev);
 	if (!soc)
@@ -378,16 +400,7 @@
 	if (!strcmp(soc->fw_rv32.name, NPU_EN7581_7996_FIRMWARE_RV32))
 		priv->txbuf_min_size = NPU_EN7581_7996_TX_CHECK_SIZE;
 
-	/* Load rv32 npu firmware */
-	ret = airoha_npu_load_firmware(dev, addr, soc->fw_rv32.name,
-				       soc->fw_rv32.max_size);
-	if (ret)
-		return ret;
-
-	/* Load data npu firmware */
-	return airoha_npu_load_firmware(dev, base + REG_NPU_LOCAL_SRAM,
-					soc->fw_data.name,
-					soc->fw_data.max_size);
+	return airoha_npu_load_firmware(dev, addr, base, soc);
 }
 
 static irqreturn_t airoha_npu_mbox_handler(int irq, void *npu_instance)
