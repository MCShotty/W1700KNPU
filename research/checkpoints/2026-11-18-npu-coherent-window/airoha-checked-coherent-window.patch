+int airoha_npu_wlan_alloc_queue_mem(struct airoha_npu *npu, struct device *endpoint,
+				    struct device *dma_dev, unsigned int count,
+				    size_t desc_size, size_t entry_size, bool rx_event,
+				    struct airoha_npu_wlan_queue_mem *out)
+{
+	struct airoha_npu_priv *priv = container_of(npu, struct airoha_npu_priv, npu);
+	struct airoha_npu_wlan_queue_mem mem = {};
+	struct airoha_npu_dma_lifetime *life;
+	size_t desc_bytes, entry_bytes, bytes;
+	int err;
+
+	if (!priv->checked_pair)
+		return AIROHA_NPU_WLAN_QUEUE_MANAGED;
+	if (!out || !count || !desc_size || !entry_size ||
+	    check_mul_overflow((size_t)count, desc_size, &desc_bytes) ||
+	    check_mul_overflow((size_t)count, entry_size, &entry_bytes) ||
+	    check_add_overflow(desc_bytes, entry_bytes, &bytes))
+		return -EINVAL;
+	if (bytes > NPU_WLAN_MAX_QUEUE_BYTES)
+		return -ENOSPC;
+
+	if (rx_event) {
+		err = airoha_npu_wlan_alloc_rx_event_session(npu, endpoint, dma_dev,
+							     count, desc_size, &mem.desc,
+							     &mem.dma_addr);
+		if (err)
+			return err;
+	}
+
+	mutex_lock(&priv->wlan_session_lock);
+	life = priv->dma_lifetime;
+	err = priv->wlan_session_error;
+	if (err)
+		goto unlock;
+	if (!life || !life->exposed || !life->endpoint_bound ||
+	    life->endpoint != endpoint || life->dev != dma_dev ||
+	    life->dev != npu->dev || life->boot_identity != priv->boot_identity) {
+		err = -ENODEV;
+		goto unlock;
+	}
+	if (life->queue_mem_count >= ARRAY_SIZE(life->queue_mem) ||
+	    bytes > NPU_WLAN_MAX_QUEUE_BYTES - life->queue_mem_bytes) {
+		err = -ENOSPC;
+		goto unlock;
+	}
+	if (rx_event && (!life->rx_published || !mem.desc ||
+			 life->rx_event.buf != mem.desc ||
+			 life->rx_event.addr != mem.dma_addr ||
+			 life->rx_event.bytes != desc_bytes)) {
+		err = -EPROTO;
+		goto unlock;
+	}
+
+	mem.entry = kvzalloc(entry_bytes, GFP_KERNEL);
+	if (!mem.entry) {
+		err = -ENOMEM;
+		goto unlock;
+	}
+	if (!rx_event) {
+		mem.desc = dma_alloc_coherent(dma_dev, desc_bytes, &mem.dma_addr,
+					      GFP_KERNEL);
+		if (!mem.desc) {
+			kvfree(mem.entry);
+			err = -ENOMEM;
+			goto unlock;
+		}
+	}
+
+	/* Record both objects before returning pointers to the consumer. */
+	life->queue_mem[life->queue_mem_count++] =
+		(struct airoha_npu_retained_queue_mem) {
+			.mem = mem,
+			.desc_bytes = rx_event ? 0 : desc_bytes,
+			.entry_bytes = entry_bytes,
+		};
+	life->queue_mem_bytes += bytes;
+	*out = mem;
+unlock:
+	mutex_unlock(&priv->wlan_session_lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_npu_wlan_alloc_queue_mem);
