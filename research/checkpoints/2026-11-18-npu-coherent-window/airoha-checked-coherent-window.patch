+static int airoha_npu_attach_coherent_pool(struct airoha_npu_priv *priv)
+{
+	struct device *dev = priv->npu.dev;
+	struct device_node *np = dev->of_node;
+	bool w1700k = of_machine_is_compatible("gemtek,w1700k-ubi");
+	struct device_node *node __free(device_node) = NULL;
+	struct resource pool, other;
+	int count, idx, err, i;
+
+	idx = of_property_match_string(np, "memory-region-names", "dma");
+	if (idx < 0) {
+		if (!w1700k && (idx == -EINVAL || idx == -ENODATA))
+			return 0;
+		return dev_err_probe(dev, idx, "missing NPU coherent DMA pool\n");
+	}
+
+	count = of_property_count_u32_elems(np, "memory-region");
+	if (!idx || idx != count - 1 ||
+	    count != of_property_count_strings(np, "memory-region-names") ||
+	    !of_device_is_compatible(np, "airoha,en7581-npu"))
+		return dev_err_probe(dev, -EINVAL, "invalid NPU DMA region list\n");
+
+	node = of_parse_phandle(np, "memory-region", idx);
+	if (!node || !of_device_is_available(node) ||
+	    of_property_count_strings(node, "compatible") != 1 ||
+	    !of_device_is_compatible(node, "shared-dma-pool") ||
+	    !of_property_read_bool(node, "no-map") ||
+	    of_property_read_bool(node, "reusable") ||
+	    of_property_read_bool(node, "linux,dma-default") ||
+	    of_property_read_bool(node, "linux,cma-default"))
+		return dev_err_probe(dev, -EINVAL, "NPU DMA pool must be dedicated\n");
+
+	err = of_reserved_mem_region_to_resource(np, idx, &pool);
+	if (err)
+		return dev_err_probe(dev, err, "NPU DMA pool was not reserved\n");
+	if (!airoha_npu_memory_valid(&pool) ||
+	    !IS_ALIGNED(pool.start | resource_size(&pool), PAGE_SIZE) ||
+	    pool.start < NPU_EN7581_DRAM_START || pool.end > NPU_EN7581_DRAM_END ||
+	    (w1700k && resource_size(&pool) < SZ_16M))
+		return dev_err_probe(dev, -ERANGE, "NPU DMA pool outside usable DRAM\n");
+
+	/* Firmware uses the same DRAM addresses as the host. */
+	if (dev->dma_range_map || device_iommu_mapped(dev) ||
+	    pool.end > min_not_zero(dev->coherent_dma_mask, dev->bus_dma_limit))
+		return dev_err_probe(dev, -ERANGE, "NPU DMA pool needs direct addressing\n");
+
+	for (i = 0; i < idx; i++) {
+		err = of_reserved_mem_region_to_resource(np, i, &other);
+		if (err)
+			return dev_err_probe(dev, err, "NPU memory region was not reserved\n");
+		if (resource_overlaps(&pool, &other))
+			return dev_err_probe(dev, -EINVAL,
+					     "NPU DMA pool overlaps reserved memory\n");
+	}
+
+#ifdef CONFIG_DMA_DECLARE_COHERENT
+	/* The pinned shared-dma-pool code can silently keep another pool. */
+	if (dev->dma_mem)
+		return dev_err_probe(dev, -EBUSY, "NPU DMA pool already assigned\n");
+	err = of_reserved_mem_device_init_by_idx(dev, np, idx);
+	if (err)
+		return dev_err_probe(dev, err, "cannot attach NPU coherent DMA pool\n");
+	priv->dma_lifetime->coherent_pool = true;
+	if (!dev->dma_mem)
+		return dev_err_probe(dev, -ENODEV, "NPU coherent DMA pool not attached\n");
+
+	return 0;
+#else
+	return dev_err_probe(dev, -EOPNOTSUPP, "no NPU coherent DMA pool support\n");
+#endif
+}
